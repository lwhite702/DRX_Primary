    "test:a11y:required": "corepack pnpm --filter deelrxcrm-app test:e2e:a11y:required",
    "test:security": "npm_config_store_dir=${PNPM_DLX_STORE_DIR:-/tmp/drx-pnpm-dlx-store} corepack pnpm dlx tsx scripts/testing/security-scan.ts",
