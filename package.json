{
  "name": "deelrx-crm",
  "version": "0.5.2",
  "private": true,
  "scripts": {
    "build": "pnpm --filter deelrxcrm-app build",
    "build:marketing": "pnpm --filter deelrxcrm-marketing build",
    "build:all": "pnpm build && pnpm build:marketing",
    "dev": "pnpm --filter deelrxcrm-app dev",
    "dev:ci": "next dev",
    "version:check": "node scripts/version.js check",
    "version:bump": "node scripts/version.js bump",
    "lint": "eslint .",
    "lint:compliance": "eslint . --max-warnings=0 || (echo '❌ Compliance violations detected' && exit 1)",
    "compliance:scan": "./scripts/scan-compliance.sh",
    "compliance:static": "pnpm compliance:scan && pnpm lint --quiet",
    "compliance:secrets": "git ls-files | grep -E '^\\.env\\.' | grep -v '^\\.env\\.example' && echo '❌ Environment files found in git - secrets may be exposed' && exit 1 || echo '✅ No environment files tracked in git'",
    "compliance:lockfiles": "if [ $(git ls-files | grep -E 'package-lock\\.json|yarn\\.lock' | wc -l) -gt 1 ]; then echo '❌ Multiple package manager lockfiles found' && exit 1; else echo '✅ Single package manager enforced'; fi",
    "compliance:imports": "eslint . --max-warnings=0 || (echo '❌ Banned vendor imports detected' && exit 1)",
    "compliance:full": "npm run compliance:secrets && npm run compliance:lockfiles && npm run compliance:imports && npm run verify:tarballs && npm run verify:lock && echo '✅ All compliance checks passed'",
    "verify:lock": "node scripts/verify-build-lock.mjs",
    "verify:tarballs": "node scripts/verify-tarballs.mjs",
    "wrelik:refresh": "node scripts/refresh-wrelik.mjs",
    "start": "next start",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@clerk/nextjs": "^6.37.1",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
