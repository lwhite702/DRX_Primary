    "version:bump": "node scripts/version.js bump",
    "lint": "corepack pnpm --filter deelrxcrm-app lint:readiness && corepack pnpm --filter deelrxcrm-marketing lint",
    "typecheck": "corepack pnpm --filter deelrxcrm-app typecheck:readiness && corepack pnpm --filter deelrxcrm-marketing typecheck",
    "copy:lint": "node scripts/copy-lint.js",
