    "test:feature-lock": "pnpm dlx tsx scripts/testing/feature-lock.ts",
    "test:unit": "pnpm --filter deelrxcrm-app test:coverage",
    "test:integration": "corepack pnpm --filter deelrxcrm-app test:integration",
    "test:e2e:web": "corepack pnpm --filter deelrxcrm-app test:e2e",
    "test:e2e:required": "corepack pnpm --filter deelrxcrm-app test:e2e:required",
    "test:e2e:auth": "corepack pnpm --filter deelrxcrm-app test:e2e:auth",
