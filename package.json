{
  "name": "deelrx-crm",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf node_modules **/.next **/dist .turbo"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.2",
      "@types/react-dom": "^19.0.2",
      "@wrelik/auth": "workspace:*",
      "@wrelik/db": "workspace:*",
      "@wrelik/storage": "workspace:*",
      "@wrelik/analytics": "workspace:*",
      "@wrelik/errors": "workspace:*",
      "@wrelik/email": "workspace:*",
      "@wrelik/jobs": "workspace:*",
      "@wrelik/config": "workspace:*",
      "@wrelik/eslint-config": "workspace:*",
      "@wrelik/tsconfig": "workspace:*"
    }
  }
}
