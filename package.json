  "scripts": {
    "postinstall": "pnpm --filter deelrxcrm-app exec prisma generate --schema prisma/schema.prisma",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:integrity": "node scripts/release/integrity-check.mjs && node scripts/release/test-integrity.mjs && node scripts/release/test-verify.mjs && node scripts/featurebase/test-import-content.mjs",
