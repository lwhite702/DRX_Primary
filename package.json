    "content:swift:write": "node --experimental-strip-types scripts/content/generate-swift-copy.mjs --write",
    "lint:compliance": "pnpm --filter deelrxcrm-app lint:compliance && pnpm --filter deelrxcrm-marketing lint && pnpm --filter deelrxcrm-mobile exec eslint src --quiet || (echo '❌ Compliance violations detected' && exit 1)",
    "compliance:scan": "cd apps/app && ./scripts/scan-compliance.sh",
    "compliance:static": "pnpm compliance:scan && pnpm lint --quiet",
    "compliance:secrets": "git ls-files | grep -E '^\\.env\\.' | grep -v '^\\.env\\.example' && echo '❌ Environment files found in git - secrets may be exposed' && exit 1 || echo '✅ No environment files tracked in git'",
    "compliance:lockfiles": "if [ $(git ls-files | grep -E 'package-lock\\.json|yarn\\.lock' | wc -l) -gt 1 ]; then echo '❌ Multiple package manager lockfiles found' && exit 1; else echo '✅ Single package manager enforced'; fi",
    "compliance:imports": "pnpm --filter deelrxcrm-app lint:compliance && pnpm --filter deelrxcrm-marketing lint && pnpm --filter deelrxcrm-mobile exec eslint src --quiet || (echo '❌ Banned vendor imports detected' && exit 1)",
    "compliance:full": "npm run compliance:secrets && npm run compliance:lockfiles && npm run compliance:imports && npm run verify:tarballs && npm run verify:lock && echo '✅ All compliance checks passed'",
    "verify:lock": "cd apps/app && node scripts/verify-build-lock.mjs",
    "verify:tarballs": "cd apps/app && node scripts/verify-tarballs.mjs",
    "wrelik:refresh": "cd apps/app && node scripts/refresh-wrelik.mjs",
    "seed:demo": "corepack pnpm --filter deelrxcrm-app seed:demo",
    "start": "corepack pnpm --filter deelrxcrm-app start",
    "test": "vitest",
    "test:repo-hygiene": "pnpm dlx tsx scripts/testing/repo-hygiene-check.ts",
    "test:audit": "pnpm dlx tsx scripts/testing/audit-repo.ts",
    "test:matrix": "pnpm test:audit && pnpm dlx tsx scripts/testing/generate-test-matrix.ts",
    "test:policy": "npm_config_store_dir=${PNPM_DLX_STORE_DIR:-/tmp/drx-pnpm-dlx-store} corepack pnpm dlx tsx scripts/testing/policy-check.ts",
    "docs:mintlify:build": "node scripts/docs/build-mintlify-help.mjs",
    "docs:mintlify:check": "node scripts/docs/build-mintlify-help.mjs --check",
    "test:docs:mintlify": "pnpm docs:mintlify:check && npm_config_store_dir=${PNPM_DLX_STORE_DIR:-/tmp/drx-pnpm-dlx-store} corepack pnpm dlx tsx scripts/testing/mintlify-docs-audit.ts",
    "test:marketing-claims": "node --experimental-strip-types scripts/testing/marketing-claims-check.ts || pnpm dlx tsx scripts/testing/marketing-claims-check.ts",
