{
  "name": "deelrx-crm",
  "version": "0.4.11",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf node_modules **/.next **/dist .turbo"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.2",
      "@types/react-dom": "^19.0.2",
      "@wrelik/auth": "file:../../packages/wrelik-auth-0.2.0.tgz",
      "@wrelik/db": "file:../../packages/wrelik-db-0.1.2.tgz",
      "@wrelik/storage": "file:../../packages/wrelik-storage-0.2.0.tgz",
      "@wrelik/analytics": "file:../../packages/wrelik-analytics-0.2.0.tgz",
      "@wrelik/errors": "file:../../packages/wrelik-errors-0.2.0.tgz",
      "@wrelik/email": "file:../../packages/wrelik-email-0.1.2.tgz",
      "@wrelik/jobs": "file:../../packages/wrelik-jobs-0.1.2.tgz",
      "@wrelik/config": "file:../../packages/wrelik-config-0.2.0.tgz",
      "@wrelik/eslint-config": "file:../../packages/wrelik-eslint-config-0.1.1.tgz",
      "@wrelik/tsconfig": "file:../../packages/wrelik-tsconfig-0.1.1.tgz"
    }
  }
}
