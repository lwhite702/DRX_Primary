    "release:cut": "node scripts/release/cut.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "normalize:next-env": "node scripts/release/normalize-next-env.mjs",
    "build": "corepack pnpm --filter deelrxcrm-app build && corepack pnpm --filter deelrxcrm-marketing build",
    "dev": "doppler run -- corepack pnpm --filter deelrxcrm-app dev",
    "dev:bypass": "corepack pnpm --filter deelrxcrm-app dev:bypass",
    "dev:bypass:webpack": "corepack pnpm --filter deelrxcrm-app dev:bypass:webpack",
    "dev:ci": "corepack pnpm --filter deelrxcrm-app dev:ci",
