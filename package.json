{
  "name": "deelrx-crm",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "testsprite:localize": "node scripts/testing/convert-testsprite-plan-to-local.mjs",
    "test:audit": "tsx scripts/testing/audit-repo.ts",
    "test:matrix": "pnpm test:audit && tsx scripts/testing/generate-test-matrix.ts",
    "test:policy": "tsx scripts/testing/policy-check.ts",
    "test:unit": "pnpm --filter deelrxcrm-app test:coverage && pnpm -r --filter \"./packages/*\" test",
    "test:integration": "pnpm --filter deelrxcrm-app test:run -- tests/integration tests/auth tests/middleware.test.ts",
    "test:e2e:web": "pnpm --filter deelrxcrm-app test:e2e",
    "test:a11y": "pnpm --filter deelrxcrm-app test:e2e -- tests/e2e/a11y.spec.ts",
    "test:security": "tsx scripts/testing/security-scan.ts",
    "test:perf": "tsx scripts/testing/perf-smoke.ts",
    "test:regression": "pnpm --filter deelrxcrm-app test:e2e -- tests/e2e/visual-regression.spec.ts && pnpm --filter deelrxcrm-app test:run -- tests/regression",
    "test:data-integrity": "tsx scripts/testing/data-integrity-check.ts",
    "test:all": "pnpm test:matrix && pnpm test:policy && pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:integration && pnpm test:e2e:web && pnpm test:a11y && pnpm test:security && pnpm test:perf && pnpm test:regression && pnpm test:data-integrity",
    "test:readiness": "tsx scripts/testing/generate-beta-checklist.ts && tsx scripts/testing/run-full-gate.ts",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf node_modules **/.next **/dist .turbo"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.2",
      "@types/react-dom": "^19.0.2",
      "@wrelik/auth": "workspace:*",
      "@wrelik/db": "workspace:*",
      "@wrelik/storage": "workspace:*",
      "@wrelik/analytics": "workspace:*",
      "@wrelik/errors": "workspace:*",
      "@wrelik/email": "workspace:*",
      "@wrelik/jobs": "workspace:*",
      "@wrelik/config": "workspace:*",
      "@wrelik/eslint-config": "workspace:*",
      "@wrelik/tsconfig": "workspace:*"
    }
  }
}
