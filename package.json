    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:copy": "node scripts/copy-lint.js",
    "docs:audit:features": "pnpm dlx tsx scripts/docs/codebase-feature-audit.ts",
    "docs:audit:gaps": "pnpm dlx tsx scripts/docs/article-gap-analysis.ts",
