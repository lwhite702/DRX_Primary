    "test:login-surfaces": "pnpm dlx tsx scripts/testing/login-surface-check.ts",
    "test:coverage:strict": "pnpm test:matrix && pnpm dlx tsx scripts/testing/coverage-strict-gate.ts",
    "test:feature-freeze": "pnpm dlx tsx scripts/testing/feature-freeze.ts",
