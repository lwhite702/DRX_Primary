<file path="components/ui/tooltip-guide.tsx">
"use client";

import { useState, useEffect } from "react";
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from "@/components/ui/popover";
import { Button } from "@/components/ui/button";
import { X, Info } from "lucide-react";

interface TooltipGuideProps {
  id: string;
  title: string;
  description: string;
  children: React.ReactNode;
  placement?: "top" | "bottom" | "left" | "right";
}

/**
 * Contextual Tooltip Guide
 *
 * Shows a tooltip on first use of a feature. Tracks dismissal
 * state in localStorage to avoid showing repeatedly.
 */
export function TooltipGuide({
  id,
  title,
  description,
  children,
  placement = "bottom",
}: TooltipGuideProps) {
  const [open, setOpen] = useState(false);
  const [dismissed, setDismissed] = useState(true);

  useEffect(() => {
    // Check if this tooltip has been dismissed
    const key = `drx_tooltip_${id}`;
    const isDismissed = localStorage.getItem(key);

    if (!isDismissed) {
      // Show tooltip after a brief delay
      setTimeout(() => {
        setDismissed(false);
        setOpen(true);
      }, 300);
    }
  }, [id]);

  const handleDismiss = () => {
    const key = `drx_tooltip_${id}`;
    localStorage.setItem(key, "true");
    setDismissed(true);
    setOpen(false);
  };

  if (dismissed) {
    return <>{children}</>;
  }

  return (
    <Popover open={open} onOpenChange={setOpen}>
      <PopoverTrigger asChild>{children}</PopoverTrigger>
      <PopoverContent
        side={placement}
        className="w-80 p-4 bg-accent/10 border-accent/30"
      >
        <div className="space-y-3">
          <div className="flex items-start justify-between gap-2">
            <div className="flex items-start gap-2">
              <Info className="h-5 w-5 text-accent flex-shrink-0 mt-0.5" />
              <div className="space-y-1">
                <h4 className="text-sm font-semibold">{title}</h4>
                <p className="text-sm text-muted-foreground">{description}</p>
              </div>
            </div>
            <Button
              variant="ghost"
              size="icon"
              className="h-6 w-6 -mt-1 -mr-1"
              onClick={handleDismiss}
            >
              <X className="h-4 w-4" />
            </Button>
          </div>
          <Button
            onClick={handleDismiss}
            size="sm"
            className="w-full bg-accent hover:bg-accent-dark text-black"
          >
            Got it
          </Button>
        </div>
      </PopoverContent>
    </Popover>
  );
}

/**
 * Hook to manually trigger tooltip display
 */
export function useTooltipGuide(id: string) {
  const reset = () => {
    const key = `drx_tooltip_${id}`;
    localStorage.removeItem(key);
  };

  const dismiss = () => {
    const key = `drx_tooltip_${id}`;
    localStorage.setItem(key, "true");
  };

  return { reset, dismiss };
}
</file>

<file path="components/ui/tour.tsx">
"use client";

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from "@/components/ui/popover";
import { cn } from "@/lib/utils";

interface TourStep {
  targetId: string; // ID of the element to attach to
  title: string;
  description: string;
  position?: "top" | "bottom" | "left" | "right";
}

interface TourProps {
  steps: TourStep[];
  onComplete: () => void;
  tourId: string; // Unique ID for local storage persistence
}

export function Tour({ steps, onComplete, tourId }: TourProps) {
  const [currentStepIndex, setCurrentStepIndex] = useState(0);
  const [isOpen, setIsOpen] = useState(false);
  const [targetElement, setTargetElement] = useState<HTMLElement | null>(null);

  // Check if tour already completed
  useEffect(() => {
    const completed = localStorage.getItem(`drx_tour_${tourId}`);
    if (completed) return;

    // Start tour
    setIsOpen(true);
  }, [tourId]);

  // Find target element
  useEffect(() => {
    if (!isOpen) return;

    // Small delay to ensure render
    const timer = setTimeout(() => {
      const step = steps[currentStepIndex];
      const el = document.getElementById(step.targetId);
      if (el) {
        setTargetElement(el);
        el.scrollIntoView({ behavior: "smooth", block: "center" });
        // Highlight effect could go here (e.g. outline)
        el.classList.add("ring-4", "ring-primary/50", "transition-all");
      } else {
        console.warn(`Tour target ${step.targetId} not found`);
      }
    }, 500);

    return () => clearTimeout(timer);
  }, [currentStepIndex, isOpen, steps]);

  // Cleanup highlight on step change
  useEffect(() => {
    return () => {
      if (targetElement) {
        targetElement.classList.remove(
          "ring-4",
          "ring-primary/50",
          "transition-all"
        );
      }
    };
  }, [targetElement]);

  const handleNext = () => {
    if (currentStepIndex < steps.length - 1) {
      setCurrentStepIndex((prev) => prev + 1);
    } else {
      finishTour();
    }
  };

  const finishTour = () => {
    setIsOpen(false);
    localStorage.setItem(`drx_tour_${tourId}`, "true");
    if (targetElement) {
      targetElement.classList.remove(
        "ring-4",
        "ring-primary/50",
        "transition-all"
      );
    }
    onComplete();
  };

  const handleSkip = () => {
    finishTour();
  };

  if (!isOpen || !steps[currentStepIndex]) return null;

  const step = steps[currentStepIndex];

  // We are "hacking" the Popover by attaching it to the target element if possible.
  // Actually, Shadcn Popover requires a Trigger as a child.
  // Since we can't easily wrap the existing UI elements without intrusive changes,
  // a "Portal" or "Overlay" approach is better for a Tour.
  // However, for simplicity and speed, let's use a fixed position card relative to viewport or
  // just a floating card if we can't do complex positioning easily.

  // Revised approach: Floating fixed card at bottom/center or near element if we calculate pos.
  // Better yet: Just a fixed overlay card is easiest for "MVP" tour.
  // BUT user asked for "Tour".

  // Let's try to find rect and position absolute.
  const rect = targetElement?.getBoundingClientRect();

  let style: React.CSSProperties = {
    position: "fixed",
    zIndex: 50,
    maxWidth: 300,
  };

  // Simple positioning logic
  if (rect) {
    // Default bottom
    style.top = rect.bottom + 10;
    style.left = rect.left;

    // Adjust if off screen
    if (style.left + 300 > window.innerWidth) {
      style.left = window.innerWidth - 320;
    }
  } else {
    // Center if no target found (fallback)
    style.top = "50%";
    style.left = "50%";
    style.transform = "translate(-50%, -50%)";
  }

  return (
    <div className="fixed inset-0 z-50 pointer-events-none">
      {/* Box shadow overlay or darkening? optional */}
      <Card
        className="pointer-events-auto shadow-2xl border-primary"
        style={style}
      >
        <CardHeader className="pb-2">
          <CardTitle className="text-base flex justify-between items-center">
            {step.title}
            <span className="text-xs text-muted-foreground font-normal">
              {currentStepIndex + 1} / {steps.length}
            </span>
          </CardTitle>
        </CardHeader>
        <CardContent className="text-sm">{step.description}</CardContent>
        <CardFooter className="flex justify-between pt-0">
          <Button variant="ghost" size="sm" onClick={handleSkip}>
            Skip
          </Button>
          <Button size="sm" onClick={handleNext}>
            {currentStepIndex === steps.length - 1 ? "Finish" : "Next"}
          </Button>
        </CardFooter>
      </Card>
    </div>
  );
}
</file>

