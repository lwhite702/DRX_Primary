                activeFilter === filter.id
                  ? "bg-primary text-primary-foreground border-primary"
                  : "bg-muted/30 text-muted-foreground border-transparent hover:bg-muted/50 hover:text-foreground",
              )}
            >
              {filter.icon && (
                <div
                  className={cn(
