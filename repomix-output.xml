            <div className="grid grid-cols-2 gap-4">
              <div
                className={`border p-6 rounded-xl cursor-pointer transition-all ${formData.defaultUnit === "g" ? "border-accent bg-accent/5 ring-1 ring-accent" : "hover:border-foreground/50"}`}
