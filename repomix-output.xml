"use client";

import { useState, useEffect } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { getSupabaseClient } from "@/lib/supabase/client";
import { toast } from "sonner";
import { Plus } from "lucide-react";

export default function AdminBusinessesPage() {
  const [businesses, setBusinesses] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [showCreateDialog, setShowCreateDialog] = useState(false);
  const [createLoading, setCreateLoading] = useState(false);
  const [businessName, setBusinessName] = useState("");
  const [businessType, setBusinessType] = useState("");
  const [ownerEmail, setOwnerEmail] = useState("");
  const supabase = getSupabaseClient();

  useEffect(() => {
    if (!supabase) {
      setLoading(false);
      return;
    }

    fetchBusinesses();
  }, [supabase]);

  const fetchBusinesses = async () => {
    if (!supabase) return;

    try {
      const { data, error } = await supabase
        .from("business_profile")
        .select("*")
        .order("created_at", { ascending: false });

      if (error) throw error;
      setBusinesses(data || []);
    } catch (error) {
      toast.error("Failed to load businesses");
      console.error(error);
    } finally {
      setLoading(false);
    }
  };

  const handleToggleActive = async (
    businessId: string,
    currentStatus: boolean
  ) => {
    if (!supabase) return;

    try {
      const { error } = await supabase
        .from("business_profile")
        .update({ is_active: !currentStatus })
        .eq("id", businessId);

      if (error) throw error;
      toast.success(`Business ${!currentStatus ? "activated" : "deactivated"}`);
      fetchBusinesses();
    } catch (error) {
      toast.error("Failed to update business status");
      console.error(error);
    }
  };

  const handleCreateBusiness = async (e: React.FormEvent) => {
    e.preventDefault();

    if (!businessName || !ownerEmail) {
      toast.error("Business name and owner email are required");
      return;
    }

    setCreateLoading(true);

    try {
      const response = await fetch("/api/admin/businesses", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          businessName,
          businessType,
          ownerEmail,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || "Failed to create business");
      }

      toast.success(`Business "${businessName}" created successfully`);
      setShowCreateDialog(false);
      setBusinessName("");
      setBusinessType("");
      setOwnerEmail("");
      fetchBusinesses();
    } catch (error) {
      toast.error(
        error instanceof Error ? error.message : "Failed to create business"
      );
    } finally {
      setCreateLoading(false);
    }
  };

  if (loading) {
    return <div className="p-4 md:p-8">Loading...</div>;
  }

  return (
    <div className="p-4 md:p-8 space-y-6">
      <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 className="text-3xl font-bold">Businesses</h1>
          <p className="text-muted-foreground mt-2">
            Manage all businesses in the system
          </p>
        </div>
        <Dialog open={showCreateDialog} onOpenChange={setShowCreateDialog}>
          <DialogTrigger asChild>
            <Button className="w-full md:w-auto">
              <Plus className="h-4 w-4 mr-2" />
              Create Business
            </Button>
          </DialogTrigger>
          <DialogContent>
            <DialogHeader>
              <DialogTitle>Create New Business</DialogTitle>
              <DialogDescription>
                Create a new business and assign it to an owner
              </DialogDescription>
            </DialogHeader>
            <form onSubmit={handleCreateBusiness} className="space-y-4">
              <div className="space-y-2">
                <Label htmlFor="businessName">Business Name *</Label>
                <Input
                  id="businessName"
                  value={businessName}
                  onChange={(e) => setBusinessName(e.target.value)}
                  placeholder="e.g., Acme Dispensary"
                  disabled={createLoading}
                  required
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="businessType">Business Type</Label>
                <Input
                  id="businessType"
                  value={businessType}
                  onChange={(e) => setBusinessType(e.target.value)}
                  placeholder="e.g., Retail, Wholesale"
                  disabled={createLoading}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="ownerEmail">Owner Email *</Label>
                <Input
                  id="ownerEmail"
                  type="email"
                  value={ownerEmail}
                  onChange={(e) => setOwnerEmail(e.target.value)}
                  placeholder="owner@example.com"
                  disabled={createLoading}
                  required
                />
              </div>
              <div className="flex justify-end gap-2">
                <Button
                  type="button"
                  variant="outline"
                  onClick={() => setShowCreateDialog(false)}
                  disabled={createLoading}
                >
                  Cancel
                </Button>
                <Button type="submit" disabled={createLoading}>
                  {createLoading ? "Creating..." : "Create Business"}
                </Button>
              </div>
            </form>
          </DialogContent>
        </Dialog>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>All Businesses ({businesses.length})</CardTitle>
        </CardHeader>
        <CardContent>
          {businesses.length === 0 ? (
            <p className="text-muted-foreground text-center py-8">
              No businesses found
            </p>
          ) : (
            <>
              {/* Mobile cards */}
              <div className="md:hidden space-y-3">
                {businesses.map((business) => (
                  <Card key={business.id} className="border-border/80">
                    <CardContent className="pt-4">
                      <div className="flex items-start justify-between gap-3">
                        <div className="min-w-0">
                          <p className="font-medium break-words">
                            {business.business_name}
                          </p>
                          <p className="text-sm text-muted-foreground mt-1">
                            {business.business_type || "-"}
                            {business.city && business.state
                              ? ` • ${business.city}, ${business.state}`
                              : ""}
                          </p>
                        </div>
                        <span
                          className={
                            "text-xs font-medium mt-1 " +
                            (business.is_active
                              ? "text-green-600"
                              : "text-muted-foreground")
                          }
                        >
                          {business.is_active ? "Active" : "Inactive"}
                        </span>
                      </div>

                      {(business.phone_number || business.email) && (
                        <div className="mt-3 text-sm">
                          {business.phone_number && (
                            <p>{business.phone_number}</p>
                          )}
                          {business.email && (
                            <p className="text-muted-foreground break-words">
                              {business.email}
                            </p>
                          )}
                        </div>
                      )}

                      <div className="mt-4 flex items-center justify-between gap-2">
                        <p className="text-xs text-muted-foreground">
                          Created{" "}
                          {new Date(business.created_at).toLocaleDateString()}
                        </p>
                        <Button
                          variant="outline"
                          size="sm"
                          onClick={() =>
                            handleToggleActive(business.id, business.is_active)
                          }
                        >
                          {business.is_active ? "Deactivate" : "Activate"}
                        </Button>
                      </div>
                    </CardContent>
                  </Card>
                ))}
              </div>

              {/* Desktop table */}
              <div className="hidden md:block">
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>Business Name</TableHead>
                      <TableHead>Type</TableHead>
                      <TableHead>Location</TableHead>
                      <TableHead>Contact</TableHead>
                      <TableHead>Created</TableHead>
                      <TableHead>Status</TableHead>
                      <TableHead>Actions</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {businesses.map((business) => (
                      <TableRow key={business.id}>
                        <TableCell className="font-medium">
                          {business.business_name}
                        </TableCell>
                        <TableCell>{business.business_type || "-"}</TableCell>
                        <TableCell>
                          {business.city && business.state
                            ? `${business.city}, ${business.state}`
                            : "-"}
                        </TableCell>
                        <TableCell>
                          <div className="space-y-1">
                            {business.phone_number && (
                              <p className="text-sm">{business.phone_number}</p>
                            )}
                            {business.email && (
                              <p className="text-sm text-muted-foreground">
                                {business.email}
                              </p>
                            )}
                          </div>
                        </TableCell>
                        <TableCell>
                          {new Date(business.created_at).toLocaleDateString()}
                        </TableCell>
                        <TableCell>
                          <span
                            className={
                              business.is_active
                                ? "text-green-600 font-medium"
                                : "text-gray-500"
                            }
                          >
                            {business.is_active ? "Active" : "Inactive"}
                          </span>
                        </TableCell>
                        <TableCell>
                          <Button
                            variant="outline"
                            size="sm"
                            onClick={() =>
                              handleToggleActive(
                                business.id,
                                business.is_active
                              )
                            }
                          >
                            {business.is_active ? "Deactivate" : "Activate"}
                          </Button>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </div>
            </>
          )}
        </CardContent>
      </Card>
    </div>
  );
}
</file>

<file path="app/(app)/admin/features/page.tsx">
"use client";

import { useState, useEffect } from "react";
import { getSupabaseClient } from "@/lib/supabase/client";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { Switch } from "@/components/ui/switch";
import { PlusCircle, Trash2, Flag } from "lucide-react";
import { toast } from "sonner";
import { EmptyState } from "@/components/ui/empty-state";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import { Label } from "@/components/ui/label";
import { TableSkeleton } from "@/components/skeletons/table-skeleton";

type FeatureFlag = {
  id: string;
  description: string;
  is_global_enabled: boolean;
  created_at: string;
};

export default function FeatureFlagsPage() {
  const [features, setFeatures] = useState<FeatureFlag[]>([]);
  const [loading, setLoading] = useState(true);
  const [newFeature, setNewFeature] = useState({ id: "", description: "" });
  const [isDialogOpen, setIsDialogOpen] = useState(false);
  const supabase = getSupabaseClient();

  const fetchFeatures = async () => {
    if (!supabase) return;
    try {
      setLoading(true);
      const { data, error } = await supabase
        .from("feature_flags")
        .select("*")
        .order("id");

      if (error) throw error;
      setFeatures(data || []);
    } catch (error) {
      console.error("Error fetching features:", error);
      toast.error("Failed to load feature flags");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchFeatures();
  }, [supabase]);

  const toggleFeature = async (id: string, currentValue: boolean) => {
    if (!supabase) return;
    try {
      const { error } = await supabase
        .from("feature_flags")
        .update({ is_global_enabled: !currentValue })
        .eq("id", id);

      if (error) throw error;

      setFeatures(
        features.map((f) =>
          f.id === id ? { ...f, is_global_enabled: !currentValue } : f
        )
      );
      toast.success(
        `Feature ${id} ${!currentValue ? "enabled" : "disabled"} globally`
      );
    } catch (error) {
      toast.error("Failed to update feature");
      console.error(error);
    }
  };

  const createFeature = async () => {
    if (!supabase) return;
    try {
      if (!newFeature.id) return;

      const { error } = await supabase.from("feature_flags").insert({
        id: newFeature.id,
        description: newFeature.description,
        is_global_enabled: false,
      });

      if (error) throw error;

      toast.success("Feature created");
      setNewFeature({ id: "", description: "" });
      setIsDialogOpen(false);
      fetchFeatures();
    } catch (error) {
      toast.error("Failed to create feature");
      console.error(error);
    }
  };

  const deleteFeature = async (id: string) => {
    if (!supabase) return;
    if (
      !confirm(
        "Are you sure? This will remove the feature flag from the system."
      )
    )
      return;

    try {
      const { error } = await supabase
        .from("feature_flags")
        .delete()
        .eq("id", id);

      if (error) throw error;

      toast.success("Feature deleted");
      setFeatures(features.filter((f) => f.id !== id));
    } catch (error) {
      toast.error("Failed to delete feature");
      console.error(error);
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">Feature Flags</h1>
          <p className="text-muted-foreground">
            Manage global feature availability and rollouts.
          </p>
        </div>
        <Dialog open={isDialogOpen} onOpenChange={setIsDialogOpen}>
          <DialogTrigger asChild>
            <Button>
              <PlusCircle className="mr-2 h-4 w-4" />
              Add Feature
            </Button>
          </DialogTrigger>
          <DialogContent>
            <DialogHeader>
              <DialogTitle>Add New Feature Flag</DialogTitle>
              <DialogDescription>
                Create a new feature flag key. Default state will be disabled.
              </DialogDescription>
            </DialogHeader>
            <div className="space-y-4 py-4">
              <div className="space-y-2">
                <Label htmlFor="id">Feature ID (Key)</Label>
                <Input
                  id="id"
                  placeholder="e.g. ai_insights"
                  value={newFeature.id}
                  onChange={(e) =>
                    setNewFeature({ ...newFeature, id: e.target.value })
                  }
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="desc">Description</Label>
                <Input
                  id="desc"
                  placeholder="Feature description"
                  value={newFeature.description}
                  onChange={(e) =>
                    setNewFeature({
                      ...newFeature,
                      description: e.target.value,
                    })
                  }
                />
              </div>
            </div>
            <DialogFooter>
              <Button variant="outline" onClick={() => setIsDialogOpen(false)}>
                Cancel
              </Button>
              <Button onClick={createFeature}>Create</Button>
            </DialogFooter>
          </DialogContent>
        </Dialog>
      </div>

      <div className="border rounded-lg">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>ID</TableHead>
              <TableHead>Description</TableHead>
              <TableHead>Global Status</TableHead>
              <TableHead className="text-right">Actions</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {loading ? (
              <TableRow>
                <TableCell colSpan={4} className="p-0 border-none">
                  <div className="p-4">
                    <TableSkeleton rowCount={5} columnCount={4} />
                  </div>
                </TableCell>
              </TableRow>
            ) : features.length === 0 ? (
              <TableRow>
                <TableCell colSpan={4} className="p-0 border-none">
                  <div className="p-4">
                    <EmptyState
                      icon={Flag}
                      title="No feature flags"
                      description="Create a feature flag to control system behavior."
                      actionLabel="Add Feature"
                      onAction={() => setIsDialogOpen(true)}
                    />
                  </div>
                </TableCell>
              </TableRow>
            ) : (
              features.map((feature) => (
                <TableRow key={feature.id}>
                  <TableCell className="font-mono">{feature.id}</TableCell>
                  <TableCell>{feature.description}</TableCell>
                  <TableCell>
                    <div className="flex items-center gap-2">
                      <Switch
                        checked={feature.is_global_enabled}
                        onCheckedChange={() =>
                          toggleFeature(feature.id, feature.is_global_enabled)
                        }
                      />
                      <span className="text-sm text-muted-foreground">
                        {feature.is_global_enabled ? "Enabled" : "Disabled"}
                      </span>
                    </div>
                  </TableCell>
                  <TableCell className="text-right">
                    <Button
                      variant="ghost"
                      size="icon"
                      onClick={() => deleteFeature(feature.id)}
                    >
                      <Trash2 className="h-4 w-4 text-destructive" />
                    </Button>
                  </TableCell>
                </TableRow>
              ))
            )}
          </TableBody>
        </Table>
      </div>
    </div>
  );
}
</file>

<file path="app/(app)/admin/users/page.tsx">
"use client";

import { useState, useEffect } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { getSupabaseClient } from "@/lib/supabase/client";
import { toast } from "sonner";
import { Loader2, Pencil, Trash2, ShieldAlert } from "lucide-react";
import { updateUserRole } from "@/app/actions/user-management";
import { initiateRTBF } from "@/app/actions/rtbf";
import { Role, ROLES } from "@/lib/auth/permissions";

// Helper for badge colors
const getRoleBadgeColor = (role: string) => {
  switch (role?.toLowerCase()) {
    case "super_admin":
      return "bg-purple-600 hover:bg-purple-700";
    case "owner":
      return "bg-red-600 hover:bg-red-700";
    case "manager":
      return "bg-blue-600 hover:bg-blue-700";
    case "supervisor":
      return "bg-amber-600 hover:bg-amber-700";
    case "cashier":
      return "bg-green-600 hover:bg-green-700";
    default:
      return "bg-gray-500";
  }
};

export default function AdminUsersPage() {
  const [users, setUsers] = useState<any[]>([]);
  const [currentUserRole, setCurrentUserRole] = useState<string>("");
  const [loading, setLoading] = useState(true);
  const [selectedUser, setSelectedUser] = useState<any>(null);
  const [newRole, setNewRole] = useState<Role | "">("");
  const [isUpdating, setIsUpdating] = useState(false);
  const [isDialogOpen, setIsDialogOpen] = useState(false);
  const [isRTBFOpen, setIsRTBFOpen] = useState(false);

  const supabase = getSupabaseClient();

  useEffect(() => {
    if (!supabase) {
      setLoading(false);
      return;
    }

    const init = async () => {
      await fetchUserContext();
      await fetchUsers();
      setLoading(false);
    };
    init();
  }, [supabase]);

  const fetchUserContext = async () => {
    const {
      data: { user },
    } = await supabase.auth.getUser();
    if (user) {
      const { data: roleData } = await supabase
        .from("user_roles")
        .select("role")
        .eq("user_id", user.id)
        .single();
      setCurrentUserRole(roleData?.role || "");
    }
  };

  const fetchUsers = async () => {
    if (!supabase) return;

    try {
      const { data, error } = await supabase
        .from("user_roles")
        .select(
          `
          *,
          business_profile:business_id(name, id)
        `,
        )
        .order("created_at", { ascending: false });

      if (error) throw error;

      const formattedUsers = (data || []).map((role: any) => ({
        id: role.id,
        user_id: role.user_id,
        role: role.role,
        business_name: role.business_profile?.name || "N/A",
        business_id: role.business_profile?.id || null,
        created_at: role.created_at,
      }));

      setUsers(formattedUsers);
    } catch (error) {
      toast.error("Failed to load users");
      console.error(error);
    }
  };

  const handleEditClick = (user: any) => {
    setSelectedUser(user);
    setNewRole((user.role as Role) || "cashier");
    setIsDialogOpen(true);
  };

  const handleRTBFClick = (user: any) => {
    setSelectedUser(user);
    setIsRTBFOpen(true);
  };

  const handleRoleUpdate = async () => {
    if (!selectedUser || !newRole) return;

    setIsUpdating(true);
    try {
      const result = await updateUserRole(
        selectedUser.user_id,
        newRole as Role,
      );

      if (result.error) {
        toast.error(result.error);
      } else {
        toast.success("User role updated successfully");
        setIsDialogOpen(false);
        fetchUsers();
      }
    } catch (error) {
      toast.error("An unexpected error occurred");
      console.error(error);
    } finally {
      setIsUpdating(false);
    }
  };

  const handleRTBFPermanentDelete = async () => {
    if (!selectedUser) return;
    setIsUpdating(true);
    try {
      const result = await initiateRTBF(
        selectedUser.business_id,
        selectedUser.user_id,
      );
      if (result.error) {
        toast.error(result.error);
      } else {
        toast.success("User data removal initiated (RTBF)");
        setIsRTBFOpen(false);
        fetchUsers();
      }
    } catch (error) {
      toast.error("Failed to process RTBF");
    } finally {
      setIsUpdating(false);
    }
  };

  if (loading) {
    return (
      <div className="p-4 md:p-8 flex items-center justify-center h-48">
        <Loader2 className="animate-spin mr-2" /> Loading users...
      </div>
    );
  }

  return (
    <div className="p-4 md:p-8 space-y-6">
      <div className="flex justify-between items-center">
        <div>
          <h1 className="text-3xl font-bold tracking-tight">User Management</h1>
          <p className="text-muted-foreground mt-2">
            Manage staff roles, access levels, and privacy compliance (RTBF).
          </p>
        </div>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>Business Users ({users.length})</CardTitle>
        </CardHeader>
        <CardContent>
          {users.length === 0 ? (
            <p className="text-muted-foreground text-center py-8">
              No users found in this context
            </p>
          ) : (
            <div className="overflow-x-auto">
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>User Identification</TableHead>
                    <TableHead>Business/Tenant</TableHead>
                    <TableHead>Current Role</TableHead>
                    <TableHead>Access Granted</TableHead>
                    <TableHead className="text-right">Administration</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {users.map((user) => (
                    <TableRow key={user.id} className="group">
                      <TableCell className="font-mono text-xs">
                        <div className="flex flex-col">
                          <span className="text-foreground font-medium">
                            {user.user_id.substring(0, 8)}...
                          </span>
                          <span className="text-muted-foreground text-[10px]">
                            {user.user_id}
                          </span>
                        </div>
                      </TableCell>
                      <TableCell>{user.business_name}</TableCell>
                      <TableCell>
                        <Badge
                          className={`${getRoleBadgeColor(user.role)} text-[10px] uppercase px-2 py-0.5`}
                        >
                          {user.role}
                        </Badge>
                      </TableCell>
                      <TableCell className="text-xs text-muted-foreground font-mono">
                        {new Date(user.created_at).toLocaleDateString()}
                      </TableCell>
                      <TableCell className="text-right">
                        <div className="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                          <Button
                            variant="outline"
                            size="sm"
                            className="h-8"
                            onClick={() => handleEditClick(user)}
                          >
                            <Pencil className="w-3.5 h-3.5 mr-1" /> Edit
                          </Button>
                          <Button
                            variant="ghost"
                            size="sm"
                            className="h-8 text-destructive hover:text-destructive hover:bg-destructive/10"
                            onClick={() => handleRTBFClick(user)}
                          >
                            <Trash2 className="w-3.5 h-3.5 mr-1" /> RTBF
                          </Button>
                        </div>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </div>
          )}
        </CardContent>
      </Card>

      {/* Edit Role Dialog */}
      <Dialog open={isDialogOpen} onOpenChange={setIsDialogOpen}>
        <DialogContent className="sm:max-w-[425px]">
          <DialogHeader>
            <DialogTitle>Update Role Assignment</DialogTitle>
            <DialogDescription>
              Assign a new role level. Note: You cannot assign roles higher than
              your own.
            </DialogDescription>
          </DialogHeader>

          <div className="space-y-4 py-4">
            <div className="space-y-2">
              <label className="text-sm font-semibold">Hierarchy Level</label>
              <Select
                value={newRole}
                onValueChange={(val) => setNewRole(val as Role)}
                disabled={isUpdating}
              >
                <SelectTrigger className="w-full">
                  <SelectValue placeholder="Identify Role" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value={ROLES.CASHIER}>
                    Cashier (Tier 1)
                  </SelectItem>
                  <SelectItem value={ROLES.SUPERVISOR}>
                    Supervisor (Tier 2)
                  </SelectItem>
                  <SelectItem value={ROLES.MANAGER}>
                    Manager (Tier 3)
                  </SelectItem>
                  {/* Only super_admin can assign super_admin */}
                  {currentUserRole === "super_admin" && (
                    <SelectItem value={ROLES.SUPER_ADMIN}>
                      Super Admin (Tier 4)
                    </SelectItem>
                  )}
                </SelectContent>
              </Select>
              <div className="bg-muted p-3 rounded-md mt-4">
                <p className="text-[11px] text-muted-foreground leading-relaxed">
                  <span className="font-bold text-foreground">
                    Hierarchy Rule:
                  </span>
                  {currentUserRole === "manager"
                    ? " As a Manager, you can assign levels up to Tier 3."
                    : " You have administrative override permissions."}
                </p>
              </div>
            </div>
          </div>

          <DialogFooter>
            <Button
              variant="ghost"
              onClick={() => setIsDialogOpen(false)}
              disabled={isUpdating}
            >
              Discard
            </Button>
            <Button
              onClick={handleRoleUpdate}
              disabled={isUpdating || !newRole}
            >
              {isUpdating && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}
              Apply Role
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* RTBF Confirmation Dialog */}
      <Dialog open={isRTBFOpen} onOpenChange={setIsRTBFOpen}>
        <DialogContent className="sm:max-w-[425px] border-destructive/30">
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2 text-destructive">
              <ShieldAlert className="w-5 h-5" /> Right to be Forgotten
            </DialogTitle>
            <DialogDescription>
              This is a permanent compliance action. The user's PII will be
              masked and all tenant associations revoked. This action is logged
              for audit trails.
            </DialogDescription>
          </DialogHeader>

          <div className="bg-destructive/5 border border-destructive/20 p-4 rounded-md space-y-2 my-2">
            <p className="text-xs font-bold text-destructive underline">
              IRREVERSIBLE ACTION
            </p>
            <p className="text-[11px] text-muted-foreground">
              User ID:{" "}
              <span className="font-mono">{selectedUser?.user_id}</span>
            </p>
            <p className="text-[11px] text-muted-foreground">
              Tenant:{" "}
              <span className="font-semibold">
                {selectedUser?.business_name}
              </span>
            </p>
          </div>

          <DialogFooter>
            <Button
              variant="ghost"
              onClick={() => setIsRTBFOpen(false)}
              disabled={isUpdating}
            >
              Cancel
            </Button>
            <Button
              variant="destructive"
              onClick={handleRTBFPermanentDelete}
              disabled={isUpdating}
            >
              {isUpdating && <Loader2 className="w-4 h-4 mr-2 animate-spin" />}
              Confirm Shredding
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
</file>

