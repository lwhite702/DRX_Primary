              helps us configure your privacy, inventory, and checkout settings.
            </p>
          </div>
        );

      case "details":
        return (
          <div className="space-y-4">
            <div className="grid gap-2">
              <Label>Business Name</Label>
              <Input
                value={formData.businessName}
