            </CardTitle>
          </CardHeader>
          <CardContent className="space-y-4">
            {customer ? (
              <div className="space-y-3">
                <div>
                  <p className="text-sm text-muted-foreground">Name</p>
                  <p className="font-medium">
                    {customer.first_name} {customer.last_name}
                  </p>
                </div>
                {customer.phone_number && (
                  <div>
                    <p className="text-sm text-muted-foreground">Phone</p>
                    <p className="font-medium">{customer.phone_number}</p>
                  </div>
                )}
                {customer.email && (
                  <div>
                    <p className="text-sm text-muted-foreground">Email</p>
                    <p className="font-medium">{customer.email}</p>
                  </div>
                )}
                {customer.loyalty_tier && customer.loyalty_tier !== "none" && (
                  <div>
                    <p className="text-sm text-muted-foreground">
                      Loyalty Tier
                    </p>
                    <Badge className="capitalize">
                      {customer.loyalty_tier}
                    </Badge>
                  </div>
                )}
                <Button
                  variant="outline"
                  className="w-full"
                  onClick={() => setShowCustomerSelector(true)}
                  disabled={assigning}
                >
                  Change Customer
                </Button>
              </div>
            ) : (
              <div className="space-y-3">
                <p className="text-sm text-muted-foreground">
                  No customer assigned to this sale
                </p>
                <Button
                  variant="default"
                  className="w-full"
                  onClick={() => setShowCustomerSelector(true)}
                  disabled={assigning}
                >
                  <User className="h-4 w-4 mr-2" />
                  Assign Customer
                </Button>
              </div>
            )}

            {sale.payment_method === "credit" && (
              <div className="p-3 bg-yellow-50 border border-yellow-200 rounded-md">
                <p className="text-xs text-yellow-800">
                  ⚠️ This is a credit sale. Manager or owner role required to
                  reassign customer.
                </p>
              </div>
            )}
          </CardContent>
        </Card>
      </div>

      {/* Customer Selector Modal */}
      <CustomerSelectorModal
        open={showCustomerSelector}
        onOpenChange={setShowCustomerSelector}
        customers={customers}
        onSelect={handleAssignCustomer}
        selectedCustomerId={customer?.id}
      />
    </div>
  );
}
