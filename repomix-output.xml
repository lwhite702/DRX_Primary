      console.log(`   ✅ Found existing admin user: ${adminId}`);
    }

    // Step 2: Truncate all application tables
    console.log("\n🗑️  Step 2: Truncating application tables...");

    // Topological order (children first)
    const tablesToTruncate = [
      "sales_line_items",
      "sales",
      "credit_transactions",
      "credit_limits",
      "inventory_log",
      "inventory",
      "customers",
      "customer_notes",
