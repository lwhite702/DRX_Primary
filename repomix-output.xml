import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { AlertTriangle, TrendingUp, BarChart3, RefreshCw } from "lucide-react";
import { toast } from "sonner";
import { getSupabaseClient } from "@/lib/supabase/client";

interface AIIntelligenceDashboardProps {
  businessId: string;
}

export function AIIntelligenceDashboard({ businessId }: AIIntelligenceDashboardProps) {
  const [loading, setLoading] = useState(true);
  const [analyzing, setAnalyzing] = useState(false);
  const [data, setData] = useState({
    pricingRecommendations: 0,
    criticalAlerts: 0,
    urgentRestocks: 0,
    opportunitiesCount: 0,
  });

  const supabase = getSupabaseClient();

  useEffect(() => {
    fetchDashboardData();
  }, [businessId]);

  const fetchDashboardData = async () => {
    if (!supabase) return;

    setLoading(true);
    try {
      const [pricingRes, alertsRes, forecastsRes] = await Promise.all([
        supabase
          .from("ai_pricing_recommendations")
          .select("count", { count: "exact" })
          .eq("business_id", businessId)
          .eq("status", "pending"),
        supabase
          .from("inventory_alerts")
          .select("count", { count: "exact" })
          .eq("business_id", businessId)
          .eq("acknowledged", false)
          .in("severity", ["high", "critical"]),
        supabase
          .from("inventory_forecasts")
          .select("count", { count: "exact" })
          .eq("business_id", businessId)
          .in("restock_urgency", ["high", "critical"]),
      ]);

      setData({
        pricingRecommendations: pricingRes.count || 0,
        criticalAlerts: alertsRes.count || 0,
        urgentRestocks: forecastsRes.count || 0,
        opportunitiesCount: (pricingRes.count || 0) + (forecastsRes.count || 0),
      });
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
      toast.error("Failed to load AI intelligence data");
    } finally {
      setLoading(false);
    }
  };

  const handleRunAnalysis = async () => {
    setAnalyzing(true);
    try {
      const response = await fetch("/api/ai/analyze", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          business_id: businessId,
          analysis_type: "all",
        }),
      });

      if (!response.ok) throw new Error("Analysis failed");

      const result = await response.json();
      toast.success(`Analysis complete: ${result.processed_count} items analyzed`);
      await fetchDashboardData();
    } catch (error) {
      toast.error("Failed to run analysis");
    } finally {
      setAnalyzing(false);
    }
  };

  const StatCard = ({
    label,
    value,
    icon: Icon,
    color,
  }: {
    label: string;
    value: number;
    icon: React.ReactNode;
    color: string;
  }) => (
    <div className={`p-4 rounded-lg border ${color}`}>
      <div className="flex items-center gap-3">
        <div className="flex-1">
          <p className="text-xs text-muted-foreground">{label}</p>
          <p className="text-2xl font-bold mt-1">{value}</p>
        </div>
        <div className="opacity-50">{Icon}</div>
      </div>
    </div>
  );

  return (
    <div className="space-y-4">
      <Card>
        <CardHeader className="pb-3">
          <div className="flex items-center justify-between">
            <CardTitle>AI Intelligence Dashboard</CardTitle>
            <Button
              onClick={handleRunAnalysis}
              disabled={analyzing}
              size="sm"
              variant="outline"
            >
              <RefreshCw className="h-4 w-4 mr-2" />
              {analyzing ? "Analyzing..." : "Run Analysis"}
            </Button>
          </div>
        </CardHeader>
        <CardContent>
          {loading ? (
            <div className="text-center py-8">
              <p className="text-muted-foreground">Loading intelligence data...</p>
            </div>
          ) : (
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
              <StatCard
                label="Pricing Recommendations"
                value={data.pricingRecommendations}
                icon={<TrendingUp className="h-6 w-6 text-blue-500" />}
                color="border-blue-200 bg-blue-50"
              />
              <StatCard
                label="Critical Alerts"
                value={data.criticalAlerts}
                icon={<AlertTriangle className="h-6 w-6 text-red-500" />}
                color="border-red-200 bg-red-50"
              />
              <StatCard
                label="Urgent Restocks"
                value={data.urgentRestocks}
                icon={<BarChart3 className="h-6 w-6 text-orange-500" />}
                color="border-orange-200 bg-orange-50"
              />
              <StatCard
                label="Total Opportunities"
                value={data.opportunitiesCount}
                icon={<TrendingUp className="h-6 w-6 text-green-500" />}
                color="border-green-200 bg-green-50"
              />
            </div>
          )}
        </CardContent>
      </Card>

      {/* Key Insights */}
      <Card>
        <CardHeader>
          <CardTitle className="text-base">Key Insights</CardTitle>
        </CardHeader>
        <CardContent>
          <ul className="space-y-2 text-sm">
            {data.pricingRecommendations > 0 && (
              <li className="flex items-start gap-2">
                <span className="text-blue-500 mt-1">•</span>
                <span>
                  <strong>{data.pricingRecommendations} pricing recommendation(s)</strong> waiting
                  for review. Apply to optimize margins and competitiveness.
                </span>
              </li>
            )}
            {data.criticalAlerts > 0 && (
              <li className="flex items-start gap-2">
                <span className="text-red-500 mt-1">•</span>
                <span>
                  <strong>{data.criticalAlerts} critical alert(s)</strong> require immediate
                  attention to prevent stockouts or losses.
                </span>
              </li>
            )}
            {data.urgentRestocks > 0 && (
              <li className="flex items-start gap-2">
                <span className="text-orange-500 mt-1">•</span>
                <span>
                  <strong>{data.urgentRestocks} item(s)</strong> need urgent restock to avoid
                  lost sales.
                </span>
              </li>
            )}
            {data.opportunitiesCount === 0 && (
              <li className="text-muted-foreground">
                No immediate AI recommendations. Inventory and pricing are optimized.
              </li>
            )}
          </ul>
        </CardContent>
      </Card>
    </div>
  );
}
</file>

<file path="components/ai/inventory-forecast-card.tsx">
"use client";

import { useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { AlertTriangle, TrendingUp, TrendingDown, Clock } from "lucide-react";
import { toast } from "sonner";
import { type InventoryForecastResult } from "@/lib/utils/inventory-engine";
import { getSupabaseClient } from "@/lib/supabase/client";

interface InventoryForecastCardProps {
  forecast: InventoryForecastResult | null;
  currentStock: number;
  reorderLevel: number;
  productName: string;
  sku: string;
  inventoryId: string;
  businessId: string;
  forecastId?: string;
  onRestock?: (quantity: number) => void;
}

export function InventoryForecastCard({
  forecast,
  currentStock,
  reorderLevel,
  productName,
  sku,
  inventoryId,
  businessId,
  forecastId,
  onRestock,
}: InventoryForecastCardProps) {
  const [acknowledging, setAcknowledging] = useState(false);
  const supabase = getSupabaseClient();

  if (!forecast) {
    return null;
  }

  const urgencyColors = {
    low: "border-blue-200 bg-blue-50",
    medium: "border-yellow-200 bg-yellow-50",
    high: "border-orange-200 bg-orange-50",
    critical: "border-red-200 bg-red-50",
  };

  const urgencyBadgeColors = {
    low: "bg-blue-100 text-blue-800",
    medium: "bg-yellow-100 text-yellow-800",
    high: "bg-orange-100 text-orange-800",
    critical: "bg-red-100 text-red-800",
  };

  const handleAcknowledgeAlert = async () => {
    if (!supabase) {
      toast.error("Unable to acknowledge");
      return;
    }

    setAcknowledging(true);
    try {
      // In a real scenario, we'd acknowledge specific alerts
      // For now, just log the acknowledgment
      toast.success("Alert acknowledged");
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "Failed to acknowledge");
    } finally {
      setAcknowledging(false);
    }
  };

  const getVelocityIcon = () => {
    switch (forecast.velocityTrend) {
      case "accelerating":
        return <TrendingUp className="h-4 w-4 text-green-600" />;
      case "declining":
        return <TrendingDown className="h-4 w-4 text-red-600" />;
      case "stagnant":
        return <AlertTriangle className="h-4 w-4 text-yellow-600" />;
      default:
        return <Clock className="h-4 w-4 text-blue-600" />;
    }
  };

  return (
    <Card className={urgencyColors[forecast.restockUrgency]}>
      <CardHeader className="pb-3">
        <div className="flex items-start justify-between">
          <div className="flex-1">
            <CardTitle className="text-lg">Inventory Forecast</CardTitle>
            <p className="text-xs text-muted-foreground mt-1">
              {productName} • {sku}
            </p>
          </div>
          <div className="flex items-center gap-2">
            {getVelocityIcon()}
            <span className={`text-xs font-semibold px-2 py-1 rounded ${urgencyBadgeColors[forecast.restockUrgency]}`}>
              {forecast.restockUrgency.toUpperCase()}
            </span>
          </div>
        </div>
      </CardHeader>
      <CardContent className="space-y-4">
        {/* Stock Status */}
        <div className="grid grid-cols-3 gap-3">
          <div>
            <p className="text-xs text-muted-foreground">Current</p>
            <p className="text-lg font-semibold">{currentStock} units</p>
          </div>
          <div>
            <p className="text-xs text-muted-foreground">Reorder Level</p>
            <p className="text-lg font-semibold">{reorderLevel} units</p>
          </div>
          <div>
            <p className="text-xs text-muted-foreground">Recommended</p>
            <p className="text-lg font-semibold text-blue-600">
              {forecast.recommendedRestockQuantity} units
            </p>
          </div>
        </div>

        {/* Stockout Projection */}
        {forecast.daysUntilStockout !== null && (
          <div className="bg-white p-2 rounded">
            <p className="text-xs text-muted-foreground mb-1">Projected Stockout</p>
            <div className="flex items-baseline gap-2">
              <p className="text-sm font-semibold">
                {forecast.daysUntilStockout === Infinity
                  ? "No immediate risk"
                  : `${forecast.daysUntilStockout} days`}
              </p>
              {forecast.projectedStockoutDate && (
                <p className="text-xs text-muted-foreground">
                  on {new Date(forecast.projectedStockoutDate).toLocaleDateString()}
                </p>
              )}
            </div>
          </div>
        )}

        {/* Velocity Info */}
        <div className="grid grid-cols-3 gap-2 bg-white p-2 rounded text-xs">
          <div>
            <p className="text-muted-foreground">7d Velocity</p>
            <p className="font-semibold">{forecast.factors.velocity_7d?.toFixed(1) || "0"} units/day</p>
          </div>
          <div>
            <p className="text-muted-foreground">30d Velocity</p>
            <p className="font-semibold">{forecast.factors.velocity_30d?.toFixed(1) || "0"} units/day</p>
          </div>
          <div>
            <p className="text-muted-foreground">Trend</p>
            <p className="font-semibold capitalize">{forecast.velocityTrend}</p>
          </div>
        </div>

        {/* Reasoning */}
        <div className="bg-white p-2 rounded">
          <p className="text-xs text-muted-foreground mb-1">Forecast Reasoning</p>
          <p className="text-xs leading-relaxed">{forecast.reasoning}</p>
        </div>

        {/* Risk & Confidence */}
        <div className="flex items-center justify-between text-xs border-t pt-2">
          <div className="flex gap-4">
            <div>
              <p className="text-muted-foreground">Risk Level</p>
              <p className="font-semibold capitalize">{forecast.inventoryRiskLevel}</p>
            </div>
            <div>
              <p className="text-muted-foreground">Confidence</p>
              <p className="font-semibold">{forecast.confidenceScore.toFixed(0)}%</p>
            </div>
          </div>
        </div>

        {/* Actions */}
        <div className="flex gap-2 pt-2">
          <Button
            onClick={handleAcknowledgeAlert}
            disabled={acknowledging}
            variant="default"
            size="sm"
            className="flex-1"
          >
            {acknowledging ? "Acknowledging..." : "Acknowledge"}
          </Button>
          <Button variant="outline" size="sm" className="flex-1">
            View Details
          </Button>
        </div>
      </CardContent>
    </Card>
  );
}
</file>

<file path="components/ai/pricing-recommendation-card.tsx">
"use client";

import { useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { AlertTriangle, TrendingUp, TrendingDown, Zap } from "lucide-react";
import { toast } from "sonner";
import { type PricingRecommendation } from "@/lib/utils/pricing-engine";
import { getSupabaseClient } from "@/lib/supabase/client";

interface PricingRecommendationCardProps {
  recommendation: PricingRecommendation | null;
  currentPrice: number;
  productName: string;
  sku: string;
  inventoryId: string;
  businessId: string;
  recommendationId?: string;
  onApplied?: (newPrice: number) => void;
}

export function PricingRecommendationCard({
  recommendation,
  currentPrice,
  productName,
  sku,
  inventoryId,
  businessId,
  recommendationId,
  onApplied,
}: PricingRecommendationCardProps) {
  const [applying, setApplying] = useState(false);
  const supabase = getSupabaseClient();

  if (!recommendation) {
    return null;
  }

  const priceDifference = recommendation.recommendedPrice - currentPrice;
  const percentChange = ((priceDifference / currentPrice) * 100).toFixed(1);
  const isIncrease = priceDifference > 0;

  const handleApplyRecommendation = async () => {
    if (!supabase || !recommendationId) {
      toast.error("Unable to apply recommendation");
      return;
    }

    setApplying(true);
    try {
      const { error } = await supabase
        .from("inventory")
        .update({
          selling_price: recommendation.recommendedPrice,
          updated_at: new Date().toISOString(),
        })
        .eq("id", inventoryId);

      if (error) throw error;

      await supabase
        .from("ai_pricing_recommendations")
        .update({ status: "applied", applied_at: new Date().toISOString() })
        .eq("id", recommendationId);

      await supabase.from("ai_decision_log").insert({
        business_id: businessId,
        product_id: inventoryId,
        decision_type: "pricing",
        old_value: { selling_price: currentPrice },
        new_value: { selling_price: recommendation.recommendedPrice },
        ai_recommendation: { recommended_price: recommendation.recommendedPrice },
        reasoning: recommendation.reasoning,
        decided_by: "user",
      });

      toast.success(
        `Price updated to $${recommendation.recommendedPrice.toFixed(2)} for ${productName}`
      );
      onApplied?.(recommendation.recommendedPrice);
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "Failed to apply recommendation");
    } finally {
      setApplying(false);
    }
  };

  return (
    <Card className={isIncrease ? "border-green-200 bg-green-50" : "border-orange-200 bg-orange-50"}>
      <CardHeader className="pb-3">
        <div className="flex items-start justify-between">
          <div className="flex-1">
            <CardTitle className="text-lg">AI Recommended Price</CardTitle>
            <p className="text-xs text-muted-foreground mt-1">
              {productName} • {sku}
            </p>
          </div>
          <div className="flex items-center gap-1">
            {isIncrease ? (
              <TrendingUp className="h-4 w-4 text-green-600" />
            ) : (
              <TrendingDown className="h-4 w-4 text-orange-600" />
            )}
            <Zap className="h-4 w-4 text-yellow-500" />
          </div>
        </div>
      </CardHeader>
      <CardContent className="space-y-4">
        {/* Price Comparison */}
        <div className="grid grid-cols-3 gap-4">
          <div>
            <p className="text-xs text-muted-foreground">Current</p>
            <p className="text-lg font-semibold">${currentPrice.toFixed(2)}</p>
          </div>
          <div className="flex items-center justify-center">
            <div className={`text-sm font-bold ${isIncrease ? "text-green-600" : "text-orange-600"}`}>
              {isIncrease ? "+" : ""}{percentChange}%
            </div>
          </div>
          <div>
            <p className="text-xs text-muted-foreground">Recommended</p>
            <p className="text-lg font-semibold text-green-600">
              ${recommendation.recommendedPrice.toFixed(2)}
            </p>
          </div>
        </div>

        {/* Price Range */}
        <div className="bg-white p-2 rounded text-xs">
          <p className="text-muted-foreground mb-1">Price Range</p>
          <p className="font-mono">
            ${recommendation.recommendedRangeMin.toFixed(2)} - $
            {recommendation.recommendedRangeMax.toFixed(2)}
          </p>
        </div>

        {/* Reasoning */}
        <div className="bg-white p-2 rounded">
          <p className="text-xs text-muted-foreground mb-1">Why?</p>
          <p className="text-xs leading-relaxed">{recommendation.reasoning}</p>
        </div>

        {/* Confidence */}
        <div className="flex items-center justify-between text-xs">
          <span className="text-muted-foreground">Confidence</span>
          <span className="font-semibold">{recommendation.confidenceScore.toFixed(0)}%</span>
        </div>

        {/* Actions */}
        <div className="flex gap-2 pt-2">
          <Button
            onClick={handleApplyRecommendation}
            disabled={applying}
            className="flex-1"
            size="sm"
          >
            {applying ? "Applying..." : "Apply Price"}
          </Button>
          <Button variant="outline" size="sm" className="flex-1">
            Review Details
          </Button>
        </div>
      </CardContent>
    </Card>
  );
}
</file>

<file path="components/credit/AICreditPanel.tsx">
"use client";

import { useState, useEffect } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { AlertCircle, Zap, TrendingUp, Lock } from "lucide-react";
import { toast } from "sonner";

interface CreditRecommendation {
  recommended_limit: number;
  risk_score: number;
  justification: string;
  range_min: number;
  range_max: number;
}

interface AICreditPanelProps {
  customer_id: string;
  business_id: string;
  current_limit: number;
  ai_recommended_limit?: number;
  risk_score?: number;
  last_reviewed_at?: string;
  can_apply: boolean;
  user_id: string;
}

export function AICreditPanel({
  customer_id,
  business_id,
  current_limit,
  ai_recommended_limit = 0,
  risk_score = 0,
  last_reviewed_at,
  can_apply,
  user_id,
}: AICreditPanelProps) {
  const [recommendation, setRecommendation] =
    useState<CreditRecommendation | null>(null);
  const [loading, setLoading] = useState(false);
  const [applying, setApplying] = useState(false);
  const [showOverrideDialog, setShowOverrideDialog] = useState(false);
  const [overrideLimit, setOverrideLimit] = useState(current_limit);
  const [overrideReason, setOverrideReason] = useState("");

  useEffect(() => {
    // Load stored recommendation if available
    if (ai_recommended_limit > 0) {
      setRecommendation({
        recommended_limit: ai_recommended_limit,
        risk_score: risk_score || 0,
        justification: `Last reviewed: ${last_reviewed_at ? new Date(last_reviewed_at).toLocaleDateString() : "Never"}`,
        range_min: ai_recommended_limit * 0.8,
        range_max: ai_recommended_limit * 1.2,
      });
    }
  }, [ai_recommended_limit, risk_score, last_reviewed_at]);

  const handleRefresh = async () => {
    setLoading(true);
    try {
      const response = await fetch("/api/credit/refresh-customer", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ customer_id, business_id }),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || "Failed to refresh recommendation");
      }

      const data = await response.json();
      if (data.recommendation) {
        setRecommendation(data.recommendation);
        toast.success("AI recommendation updated");
      }
    } catch (error) {
      toast.error(
        error instanceof Error ? error.message : "Failed to refresh"
      );
    } finally {
      setLoading(false);
    }
  };

  const handleApplyRecommendation = async () => {
    setApplying(true);
    try {
      const response = await fetch("/api/credit/apply-recommendation", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          customer_id,
          business_id,
          user_id,
          action: "apply_ai_recommendation",
        }),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || "Failed to apply recommendation");
      }

      toast.success("Credit limit updated successfully");
      window.location.reload();
    } catch (error) {
      toast.error(
        error instanceof Error ? error.message : "Failed to apply recommendation"
      );
    } finally {
      setApplying(false);
    }
  };

  const handleOverride = async () => {
    if (!overrideReason.trim()) {
      toast.error("Please provide a reason for override");
      return;
    }

    setApplying(true);
    try {
      const response = await fetch("/api/credit/apply-recommendation", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          customer_id,
          business_id,
          user_id,
          action: "override",
          new_limit: overrideLimit,
          reason: overrideReason,
        }),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || "Failed to override limit");
      }

      toast.success("Credit limit overridden successfully");
      setShowOverrideDialog(false);
      window.location.reload();
    } catch (error) {
      toast.error(
        error instanceof Error ? error.message : "Failed to override limit"
      );
    } finally {
      setApplying(false);
    }
  };

  const getRiskColor = (score: number): string => {
    if (score >= 75) return "text-red-600";
    if (score >= 50) return "text-yellow-600";
    return "text-green-600";
  };

  const getRiskLabel = (score: number): string => {
    if (score >= 75) return "High Risk";
    if (score >= 50) return "Medium Risk";
    return "Low Risk";
  };

  return (
    <div className="space-y-4">
      {/* Current Limit Card */}
      <Card>
        <CardHeader className="pb-3">
          <CardTitle className="text-lg flex items-center gap-2">
            <Lock className="h-4 w-4" />
            Current Credit Limit
          </CardTitle>
        </CardHeader>
        <CardContent>
          <div className="text-3xl font-bold">${current_limit.toFixed(2)}</div>
          <p className="text-sm text-muted-foreground mt-1">Approved maximum credit exposure</p>
        </CardContent>
      </Card>

      {/* AI Recommendation Card */}
      {recommendation ? (
        <Card className="border-blue-200 bg-blue-50">
          <CardHeader className="pb-3">
            <CardTitle className="text-lg flex items-center gap-2">
              <Zap className="h-4 w-4 text-blue-600" />
              AI Recommendation
            </CardTitle>
          </CardHeader>
          <CardContent className="space-y-4">
            <div className="grid grid-cols-2 gap-4">
              <div>
                <Label className="text-xs text-muted-foreground">Recommended Limit</Label>
                <div className="text-2xl font-bold text-blue-600">
                  ${recommendation.recommended_limit.toFixed(2)}
                </div>
              </div>
              <div>
                <Label className="text-xs text-muted-foreground">Risk Score</Label>
                <div className={`text-2xl font-bold ${getRiskColor(recommendation.risk_score)}`}>
                  {recommendation.risk_score.toFixed(0)}/100
                </div>
                <p className="text-xs text-muted-foreground mt-1">
                  {getRiskLabel(recommendation.risk_score)}
                </p>
              </div>
            </div>

            <div className="bg-white p-3 rounded border border-blue-100">
              <p className="text-sm text-gray-700">{recommendation.justification}</p>
            </div>

            <div className="bg-white p-3 rounded border border-blue-100">
              <Label className="text-xs text-muted-foreground">Suggested Range</Label>
              <p className="text-sm font-medium mt-1">
                ${recommendation.range_min.toFixed(2)} - ${recommendation.range_max.toFixed(2)}
              </p>
            </div>

            <div className="flex gap-2 pt-2">
              <Button
                onClick={handleRefresh}
                disabled={loading}
                variant="outline"
                size="sm"
              >
                {loading ? "Refreshing..." : "Refresh Recommendation"}
              </Button>
              {can_apply && (
                <>
                  <Button
                    onClick={handleApplyRecommendation}
                    disabled={applying || loading}
                    size="sm"
                    className="bg-blue-600 hover:bg-blue-700"
                  >
                    {applying ? "Applying..." : "Apply Recommendation"}
                  </Button>
                  <Button
                    onClick={() => setShowOverrideDialog(true)}
                    variant="outline"
                    size="sm"
                  >
                    Override
                  </Button>
                </>
              )}
            </div>

            {recommendation.recommended_limit > current_limit && (
              <div className="flex gap-2 p-3 bg-green-50 border border-green-200 rounded">
                <TrendingUp className="h-4 w-4 text-green-600 flex-shrink-0 mt-0.5" />
                <p className="text-sm text-green-800">
                  <strong>Opportunity:</strong> Customer qualifies for increase of $
                  {(recommendation.recommended_limit - current_limit).toFixed(2)}
                </p>
              </div>
            )}

            {recommendation.recommended_limit < current_limit && (
              <div className="flex gap-2 p-3 bg-yellow-50 border border-yellow-200 rounded">
                <AlertCircle className="h-4 w-4 text-yellow-600 flex-shrink-0 mt-0.5" />
                <p className="text-sm text-yellow-800">
                  <strong>Caution:</strong> Recent activity suggests reducing limit by $
                  {(current_limit - recommendation.recommended_limit).toFixed(2)}
                </p>
              </div>
            )}
          </CardContent>
        </Card>
      ) : (
        <Card className="border-dashed">
          <CardContent className="pt-6">
            <p className="text-sm text-muted-foreground text-center">
              No AI recommendation available yet
            </p>
            <Button
              onClick={handleRefresh}
              disabled={loading}
              variant="outline"
              size="sm"
              className="w-full mt-4"
            >
              {loading ? "Generating..." : "Generate AI Recommendation"}
            </Button>
          </CardContent>
        </Card>
      )}

      {/* Override Dialog */}
      <Dialog open={showOverrideDialog} onOpenChange={setShowOverrideDialog}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Override Credit Limit</DialogTitle>
            <DialogDescription>
              Set a custom credit limit and provide a reason for the override.
              This action will be logged in the audit trail.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4">
            <div>
              <Label htmlFor="override_limit">New Credit Limit</Label>
              <Input
                id="override_limit"
                type="number"
                value={overrideLimit}
                onChange={(e) => setOverrideLimit(Number(e.target.value))}
                min="0"
                step="100"
                className="mt-1"
              />
            </div>
            <div>
              <Label htmlFor="override_reason">Reason for Override *</Label>
              <textarea
                id="override_reason"
                value={overrideReason}
                onChange={(e) => setOverrideReason(e.target.value)}
                placeholder="Explain why you're overriding the AI recommendation..."
                className="w-full mt-1 p-2 border rounded text-sm"
                rows={3}
              />
            </div>
            <div className="flex gap-2 justify-end">
              <Button
                variant="outline"
                onClick={() => setShowOverrideDialog(false)}
              >
                Cancel
              </Button>
              <Button
                onClick={handleOverride}
                disabled={applying || !overrideReason.trim()}
              >
                {applying ? "Saving..." : "Confirm Override"}
              </Button>
            </div>
          </div>
        </DialogContent>
      </Dialog>
    </div>
  );
}
</file>

<file path="components/credit/CreditExposureDashboard.tsx">
"use client";

import { useState, useEffect } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { AlertCircle, TrendingDown, AlertTriangle, CheckCircle } from "lucide-react";
import { toast } from "sonner";

interface ExposureMetrics {
  total_credit_limits: number;
  total_credit_balance: number;
  utilization_ratio: number;
  at_risk_customers: number;
  customers_reviewed_today: number;
}

interface CreditExposureDashboardProps {
  business_id: string;
  auto_refresh?: boolean;
  refresh_interval?: number;
}

export function CreditExposureDashboard({
  business_id,
  auto_refresh = true,
  refresh_interval = 300000, // 5 minutes
}: CreditExposureDashboardProps) {
  const [metrics, setMetrics] = useState<ExposureMetrics | null>(null);
  const [loading, setLoading] = useState(true);
  const [lastUpdated, setLastUpdated] = useState<Date | null>(null);

  const fetchMetrics = async () => {
    try {
      const response = await fetch(
        `/api/credit/exposure-report?business_id=${business_id}`
      );

      if (!response.ok) {
        throw new Error("Failed to fetch exposure metrics");
      }

      const data = await response.json();
      setMetrics(data);
      setLastUpdated(new Date());
    } catch (error) {
      console.error("Error fetching credit exposure metrics:", error);
      toast.error("Failed to load credit exposure metrics");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchMetrics();
  }, [business_id]);

  useEffect(() => {
    if (!auto_refresh) return;

    const interval = setInterval(() => {
      fetchMetrics();
    }, refresh_interval);

    return () => clearInterval(interval);
  }, [business_id, auto_refresh, refresh_interval]);

  if (loading) {
    return (
      <Card>
        <CardContent className="pt-6">
          <p className="text-muted-foreground text-center">Loading metrics...</p>
        </CardContent>
      </Card>
    );
  }

  if (!metrics) {
    return (
      <Card>
        <CardContent className="pt-6">
          <p className="text-muted-foreground text-center">
            Unable to load credit exposure metrics
          </p>
        </CardContent>
      </Card>
    );
  }

  const utilizationPercent = Math.round(metrics.utilization_ratio * 100);
  const utilizationColor =
    utilizationPercent > 80
      ? "text-red-600"
      : utilizationPercent > 60
      ? "text-yellow-600"
      : "text-green-600";

  const riskLevel =
    metrics.at_risk_customers > 0
      ? metrics.at_risk_customers > 5
        ? "critical"
        : "high"
      : "low";

  const riskIcon =
    riskLevel === "critical"
      ? AlertTriangle
      : riskLevel === "high"
      ? AlertCircle
      : CheckCircle;

  const RiskIcon = riskIcon;

  return (
    <div className="space-y-4">
      <Card>
        <CardHeader>
          <CardTitle className="flex items-center justify-between">
            <span>Credit Exposure Summary</span>
            {lastUpdated && (
              <span className="text-xs font-normal text-muted-foreground">
                Updated: {lastUpdated.toLocaleTimeString()}
              </span>
            )}
          </CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            {/* Total Credit Limits */}
            <div className="bg-slate-50 p-4 rounded">
              <p className="text-xs text-muted-foreground">Total Credit Limits</p>
              <p className="text-2xl font-bold mt-2">
                ${metrics.total_credit_limits.toFixed(2)}
              </p>
            </div>

            {/* Current Balance */}
            <div className="bg-slate-50 p-4 rounded">
              <p className="text-xs text-muted-foreground">Current Balance</p>
              <p className="text-2xl font-bold mt-2">
                ${metrics.total_credit_balance.toFixed(2)}
              </p>
            </div>

            {/* Utilization Ratio */}
            <div className="bg-slate-50 p-4 rounded">
              <p className="text-xs text-muted-foreground">Utilization Ratio</p>
              <p className={`text-2xl font-bold mt-2 ${utilizationColor}`}>
                {utilizationPercent}%
              </p>
              <div className="w-full bg-gray-200 rounded-full h-1.5 mt-2">
                <div
                  className={`h-1.5 rounded-full ${
                    utilizationPercent > 80
                      ? "bg-red-600"
                      : utilizationPercent > 60
                      ? "bg-yellow-600"
                      : "bg-green-600"
                  }`}
                  style={{ width: `${Math.min(utilizationPercent, 100)}%` }}
                />
              </div>
            </div>

            {/* Risk Status */}
            <div className="bg-slate-50 p-4 rounded">
              <p className="text-xs text-muted-foreground">Risk Status</p>
              <div className="mt-2 flex items-center gap-2">
                <RiskIcon
                  className={`h-5 w-5 ${
                    riskLevel === "critical"
                      ? "text-red-600"
                      : riskLevel === "high"
                      ? "text-yellow-600"
                      : "text-green-600"
                  }`}
                />
                <Badge
                  variant={
                    riskLevel === "critical"
                      ? "destructive"
                      : riskLevel === "high"
                      ? "outline"
                      : "secondary"
                  }
                >
                  {riskLevel === "critical"
                    ? "Critical"
                    : riskLevel === "high"
                    ? "High"
                    : "Low"}
                </Badge>
              </div>
            </div>
          </div>

          {/* At-Risk Customers Alert */}
          {metrics.at_risk_customers > 0 && (
            <div className="bg-yellow-50 border border-yellow-200 rounded p-4">
              <div className="flex gap-2">
                <AlertCircle className="h-4 w-4 text-yellow-600 flex-shrink-0 mt-0.5" />
                <div>
                  <p className="font-medium text-yellow-900">
                    {metrics.at_risk_customers} customer
                    {metrics.at_risk_customers !== 1 ? "s" : ""} at high risk
                  </p>
                  <p className="text-sm text-yellow-800">
                    Review credit limits and repayment history for these customers
                  </p>
                </div>
              </div>
            </div>
          )}

          {/* AI Review Status */}
          <div className="bg-blue-50 border border-blue-200 rounded p-4">
            <div className="flex gap-2">
              <CheckCircle className="h-4 w-4 text-blue-600 flex-shrink-0 mt-0.5" />
              <div>
                <p className="font-medium text-blue-900">
                  {metrics.customers_reviewed_today} customer
                  {metrics.customers_reviewed_today !== 1 ? "s" : ""} reviewed today
                </p>
                <p className="text-sm text-blue-800">
                  AI credit limits updated in today's scheduled refresh
                </p>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>

      {/* Recommendations */}
      <Card>
        <CardHeader>
          <CardTitle>Exposure Management Recommendations</CardTitle>
        </CardHeader>
        <CardContent>
          <ul className="space-y-2 text-sm">
            {utilizationPercent > 80 && (
              <li className="flex gap-2">
                <span className="text-red-600 font-bold">•</span>
                <span>
                  High utilization ({utilizationPercent}%). Consider reviewing and
                  adjusting credit limits or collecting payments.
                </span>
              </li>
            )}
            {metrics.at_risk_customers > 0 && (
              <li className="flex gap-2">
                <span className="text-yellow-600 font-bold">•</span>
                <span>
                  {metrics.at_risk_customers} customer(s) are at risk. Consider
                  temporary credit holds or payment plans.
                </span>
              </li>
            )}
            {utilizationPercent < 50 && metrics.at_risk_customers === 0 && (
              <li className="flex gap-2">
                <span className="text-green-600 font-bold">•</span>
                <span>
                  Healthy credit portfolio. Continue monitoring with regular AI reviews.
                </span>
              </li>
            )}
          </ul>
        </CardContent>
      </Card>
    </div>
  );
}
</file>

<file path="components/crm/ProductCostBreakdown.tsx">
"use client";

import { useEffect, useState } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Skeleton } from "@/components/ui/skeleton";
import { getSupabaseClient } from "@/lib/supabase/client";
import { TrendingUp, TrendingDown, Minus, Package, Truck } from "lucide-react";
import { format } from "date-fns";

interface CostHistoryEntry {
  id: string;
  cost_per_gram: number;
  total_cost: number;
  total_weight_grams: number;
  delivery_cost: number;
  supplier: string | null;
  created_at: string;
}

interface ProductCostBreakdownProps {
  inventoryId: string;
  productName: string;
}

export function ProductCostBreakdown({
  inventoryId,
  productName,
}: ProductCostBreakdownProps) {
  const [loading, setLoading] = useState(true);
  const [costHistory, setCostHistory] = useState<CostHistoryEntry[]>([]);
  const [latestCost, setLatestCost] = useState<CostHistoryEntry | null>(null);
  const supabase = getSupabaseClient();

  useEffect(() => {
    loadCostData();
  }, [inventoryId]);

  const loadCostData = async () => {
    if (!supabase) return;

    try {
      const { data, error } = await supabase
        .from("cost_history")
        .select("*")
        .eq("inventory_id", inventoryId)
        .order("created_at", { ascending: false })
        .limit(10);

      if (error) throw error;

      if (data && data.length > 0) {
        setCostHistory(data);
        setLatestCost(data[0]);
      }
    } catch (error) {
      console.error("Error loading cost data:", error);
    } finally {
      setLoading(false);
    }
  };

  const calculateTrend = () => {
    if (costHistory.length < 2) return { direction: "stable", change: 0 };

    const latest = costHistory[0].cost_per_gram;
    const previous = costHistory[1].cost_per_gram;
    const change = ((latest - previous) / previous) * 100;

    if (Math.abs(change) < 2) return { direction: "stable", change: 0 };
    return { direction: change > 0 ? "up" : "down", change };
  };

  const trend = calculateTrend();

  if (loading) {
    return (
      <Card>
        <CardHeader>
          <CardTitle>Cost Breakdown</CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <Skeleton className="h-20 w-full" />
          <Skeleton className="h-40 w-full" />
        </CardContent>
      </Card>
    );
  }

  if (!latestCost) {
    return (
      <Card>
        <CardHeader>
          <CardTitle>Cost Breakdown</CardTitle>
        </CardHeader>
        <CardContent>
          <p className="text-sm text-muted-foreground">
            No cost history available
          </p>
        </CardContent>
      </Card>
    );
  }

  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center justify-between">
          <span>Cost Breakdown</span>
          {trend.direction !== "stable" && (
            <Badge
              variant={trend.direction === "up" ? "destructive" : "default"}
            >
              {trend.direction === "up" ? (
                <TrendingUp className="h-3 w-3 mr-1" />
              ) : (
                <TrendingDown className="h-3 w-3 mr-1" />
              )}
              {Math.abs(trend.change).toFixed(1)}%
            </Badge>
          )}
        </CardTitle>
      </CardHeader>
      <CardContent className="space-y-6">
        {/* Latest Intake Summary */}
        <div className="space-y-3">
          <h3 className="text-sm font-semibold text-muted-foreground">
            Latest Intake
          </h3>
          <div className="grid grid-cols-2 gap-4">
            <div className="space-y-1">
              <p className="text-xs text-muted-foreground">Date</p>
              <p className="text-sm font-medium">
                {format(new Date(latestCost.created_at), "MMM d, yyyy")}
              </p>
            </div>
            <div className="space-y-1">
              <p className="text-xs text-muted-foreground">Supplier</p>
              <p className="text-sm font-medium">
                {latestCost.supplier || "N/A"}
              </p>
            </div>
            <div className="space-y-1">
              <p className="text-xs text-muted-foreground">Total Cost</p>
              <p className="text-sm font-medium">
                ${latestCost.total_cost.toFixed(2)}
              </p>
            </div>
            <div className="space-y-1">
              <p className="text-xs text-muted-foreground">Total Weight</p>
              <p className="text-sm font-medium">
                {latestCost.total_weight_grams.toFixed(2)}g
              </p>
            </div>
          </div>

          <div className="bg-primary/10 p-3 rounded-lg">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2">
                <Package className="h-4 w-4 text-primary" />
                <span className="text-sm font-semibold">Cost Per Gram</span>
              </div>
              <span className="text-lg font-bold font-mono text-primary">
                ${latestCost.cost_per_gram.toFixed(6)}/g
              </span>
            </div>
          </div>

          {latestCost.delivery_cost > 0 && (
            <div className="bg-muted p-3 rounded-lg">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <Truck className="h-4 w-4" />
                  <span className="text-sm font-semibold">Delivery Cost</span>
                </div>
                <span className="text-sm font-bold">
                  ${latestCost.delivery_cost.toFixed(2)}
                </span>
              </div>
              <p className="text-xs text-muted-foreground mt-1">
                Tracked separately, not included in cost/gram
              </p>
            </div>
          )}
        </div>

        {/* Cost History Timeline */}
        {costHistory.length > 1 && (
          <div className="space-y-3">
            <h3 className="text-sm font-semibold text-muted-foreground">
              Cost History
            </h3>
            <div className="space-y-2">
              {costHistory.slice(0, 5).map((entry, index) => (
                <div
                  key={entry.id}
                  className="flex items-center justify-between p-2 rounded border"
                >
                  <div className="flex-1">
                    <p className="text-xs text-muted-foreground">
                      {format(new Date(entry.created_at), "MMM d, yyyy")}
                    </p>
                    {entry.supplier && (
                      <p className="text-xs text-muted-foreground">
                        {entry.supplier}
                      </p>
                    )}
                  </div>
                  <div className="flex items-center gap-3">
                    <div className="text-right">
                      <p className="text-sm font-mono font-medium">
                        ${entry.cost_per_gram.toFixed(6)}/g
                      </p>
                      {entry.delivery_cost > 0 && (
                        <p className="text-xs text-muted-foreground">
                          +${entry.delivery_cost.toFixed(2)} delivery
                        </p>
                      )}
                    </div>
                    {index < costHistory.length - 1 && (
                      <div className="w-6">
                        {entry.cost_per_gram >
                        costHistory[index + 1].cost_per_gram ? (
                          <TrendingUp className="h-4 w-4 text-destructive" />
                        ) : entry.cost_per_gram <
                          costHistory[index + 1].cost_per_gram ? (
                          <TrendingDown className="h-4 w-4 text-green-600" />
                        ) : (
                          <Minus className="h-4 w-4 text-muted-foreground" />
                        )}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </CardContent>
    </Card>
  );
}
</file>

<file path="components/pos/customer-selector-modal.tsx">
"use client";

import { useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Search, User, CreditCard, Award } from "lucide-react";
import { LoyaltyBadge } from "./loyalty-badge";

interface Customer {
  id: string;
  first_name: string;
  last_name: string;
  phone_number?: string;
  email?: string;
  loyalty_tier?: string;
  discount_rate?: number;
  purchase_count?: number;
  credit_balance?: number;
  total_purchases?: number;
}

interface CustomerSelectorModalProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  customers: Customer[];
  onSelect: (customerId: string) => void;
  selectedCustomerId?: string;
}

export function CustomerSelectorModal({
  open,
  onOpenChange,
  customers,
  onSelect,
  selectedCustomerId,
}: CustomerSelectorModalProps) {
  const [searchTerm, setSearchTerm] = useState("");

  const filteredCustomers = customers.filter((customer) => {
    const searchLower = searchTerm.toLowerCase();
    const fullName =
      `${customer.first_name} ${customer.last_name}`.toLowerCase();
    const phone = customer.phone_number?.toLowerCase() || "";
    const email = customer.email?.toLowerCase() || "";

    return (
      fullName.includes(searchLower) ||
      phone.includes(searchLower) ||
      email.includes(searchLower)
    );
  });

  const handleSelect = (customerId: string) => {
    onSelect(customerId);
    onOpenChange(false);
    setSearchTerm("");
  };

  const handleClear = () => {
    onSelect("");
    onOpenChange(false);
    setSearchTerm("");
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-[600px] max-h-[80vh]">
        <DialogHeader>
          <DialogTitle>Select Customer</DialogTitle>
          <DialogDescription>
            Search and select a customer for this sale
          </DialogDescription>
        </DialogHeader>

        <div className="space-y-4">
          {/* Search */}
          <div className="relative">
            <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground h-4 w-4" />
            <Input
              placeholder="Search by name, phone, or email..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="pl-10"
            />
          </div>

          {/* Customer List */}
          <div className="space-y-2 max-h-[400px] overflow-y-auto">
            {filteredCustomers.length === 0 ? (
              <p className="text-center text-muted-foreground py-8">
                No customers found
              </p>
            ) : (
              filteredCustomers.map((customer) => (
                <div
                  key={customer.id}
                  className={`p-4 border rounded-lg hover:bg-muted/50 cursor-pointer transition-colors ${
                    selectedCustomerId === customer.id
                      ? "border-primary bg-primary/5"
                      : ""
                  }`}
                  onClick={() => handleSelect(customer.id)}
                >
                  <div className="flex items-start justify-between">
                    <div className="flex-1 space-y-2">
                      {/* Name */}
                      <div className="flex items-center gap-2">
                        <User className="h-4 w-4 text-muted-foreground" />
                        <p className="font-medium">
                          {customer.first_name} {customer.last_name}
                        </p>
                      </div>

                      {/* Contact Info */}
                      <div className="text-sm text-muted-foreground space-y-1">
                        {customer.phone_number && (
                          <p>📱 {customer.phone_number}</p>
                        )}
                        {customer.email && <p>✉️ {customer.email}</p>}
                      </div>

                      {/* Loyalty Badge */}
                      {customer.loyalty_tier &&
                        customer.loyalty_tier !== "none" && (
                          <LoyaltyBadge
                            tier={customer.loyalty_tier}
                            discount_rate={customer.discount_rate || 0}
                            purchase_count={customer.purchase_count || 0}
                          />
                        )}

                      {/* Stats */}
                      <div className="flex gap-4 text-xs text-muted-foreground">
                        {customer.total_purchases !== undefined && (
                          <span>
                            Total: ${customer.total_purchases.toFixed(2)}
                          </span>
                        )}
                        {customer.purchase_count !== undefined && (
                          <span>{customer.purchase_count} purchases</span>
                        )}
                        {customer.credit_balance !== undefined &&
                          customer.credit_balance > 0 && (
                            <span className="text-yellow-600 font-medium flex items-center gap-1">
                              <CreditCard className="h-3 w-3" />
                              Credit: ${customer.credit_balance.toFixed(2)}
                            </span>
                          )}
                      </div>
                    </div>

                    <Button
                      size="sm"
                      variant={
                        selectedCustomerId === customer.id
                          ? "default"
                          : "outline"
                      }
                      onClick={(e) => {
                        e.stopPropagation();
                        handleSelect(customer.id);
                      }}
                    >
                      {selectedCustomerId === customer.id
                        ? "Selected"
                        : "Select"}
                    </Button>
                  </div>
                </div>
              ))
            )}
          </div>

          {/* Actions */}
          <div className="flex gap-2 pt-4 border-t">
            <Button variant="outline" onClick={handleClear} className="flex-1">
              Clear Customer
            </Button>
            <Button
              variant="ghost"
              onClick={() => onOpenChange(false)}
              className="flex-1"
            >
              Cancel
            </Button>
          </div>
        </div>
      </DialogContent>
    </Dialog>
  );
}
