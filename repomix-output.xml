        assert created_inventory_id, "Inventory creation failed"

        # Adjust inventory quantity
        adjust_payload = {
            "adjustment": -10,
            "reason": "correction"
        }
        resp = requests.put(
            f"{BASE_URL}/api/inventory/{created_inventory_id}/adjust",
