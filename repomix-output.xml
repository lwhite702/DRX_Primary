  /* Animation & Transitions - Neon Velocity Motion */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in: cubic-bezier(0.55, 0.055, 0.675, 0.19);
  --ease-in-out: cubic-bezier(0.645, 0.045, 0.355, 1);

  --duration-fast: 150ms;
  --duration-normal: 300ms;
  --duration-slow: 500ms;
}

@layer base {
  * {
    @apply border-border;
  }

  html,
  body {
    @apply bg-background text-foreground overflow-x-hidden;
    overscroll-behavior-y: none; /* Prevent pull-to-refresh on mobile */
    -webkit-tap-highlight-color: transparent; /* Remove tap highlight on iOS */
  }

  /* Prevent iOS zoom on inputs */
  @media screen and (max-width: 768px) {
    input,
    select,
    textarea {
      font-size: 16px !important;
    }
  }

  .text-balance {
    text-wrap: balance;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-semibold tracking-tight;
  }

  h1 {
    @apply text-3xl;
  }

  h2 {
    @apply text-2xl;
  }

  h3 {
    @apply text-xl;
  }
}

/* Safe area utilities for PWA */
@supports (padding-bottom: env(safe-area-inset-bottom)) {
  .safe-bottom {
    padding-bottom: calc(5rem + env(safe-area-inset-bottom)) !important;
  }

  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom);
  }
}

@media (min-width: 768px) {
  .safe-bottom {
    padding-bottom: 0 !important;
  }
}

/* Modern Mobile Menu Component Styles */
:root {
  --component-inactive-color: var(--muted-foreground);
  --component-bg: var(--card);
  --component-shadow: var(--border);
  --component-active-bg: var(--secondary);
  --component-line-inactive-color: var(--border);
  --component-active-color-default: var(--accent-foreground);
}

.dark {
  --component-inactive-color: var(--muted-foreground);
  --component-bg: var(--card);
  --component-shadow: var(--border);
  --component-active-bg: var(--secondary);
  --component-line-inactive-color: var(--muted-foreground);
  --component-active-color-default: var(--accent-foreground);
}

@keyframes iconBounce {
  0%,
  100% {
    transform: translateY(0);
  }
  20% {
    transform: translateY(-0.3em);
  }
  40% {
    transform: translateY(0);
  }
  60% {
    transform: translateY(-0.1em);
  }
  80% {
    transform: translateY(0);
  }
}

/* Page Transitions */
.page-transition {
  animation: fadeIn var(--duration-normal) var(--ease-out) forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  *,
  ::before,
  ::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* Neon Velocity - Global Visual Effects */

/* Noise Overlay - Subtle physical imperfection */
.noise-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 100;
  background-image: url('data:image/svg+xml;base64,');
  opacity: 0.03;
}

/* Ambient Glow - Accent green for activity */
.ambient-glow {
  position: absolute;
  border-radius: 9999px;
  filter: blur(40px);
  opacity: 0.1;
  background: var(--color-accent);
  pointer-events: none;
}

/* Glass Effects - Protection and separation */
.glass-effect {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Laser Button - Confident CTA */
.laser-button {
  position: relative;
  overflow: hidden;
  transition: all var(--duration-normal) var(--ease-out);
}

.laser-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(191, 255, 0, 0.2), transparent);
  transition: left 0.5s ease-in-out;
}

.laser-button:hover::before {
  left: 100%;
}

/* Luminosity Card - Quiet but responsive */
.luminosity-card {
  position: relative;
  overflow: hidden;
  transition: all var(--duration-normal) var(--ease-out);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.luminosity-card:hover {
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: 0 0 20px rgba(191, 255, 0, 0.05);
}

.luminosity-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: inherit;
  border: 1px solid var(--color-accent);
  opacity: 0;
  transition: opacity var(--duration-normal) var(--ease-out);
  pointer-events: none;
}

.luminosity-card:hover::after {
  opacity: 0.1;
}

/* Typography - Neon Velocity */
.headline-text {
  font-family: var(--font-sans);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.technical-label {
  font-family: var(--font-mono);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-size: 0.75rem;
}

.body-copy {
  font-family: var(--font-body);
  line-height: 1.6;
}

/* Border Box - Sharp corners for statements */
.border-box {
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 2rem;
  display: inline-block;
}

.border-box-highlight {
  border: 1px solid var(--color-accent);
  padding: 2rem;
  display: inline-block;
}
