<file path="components/pos/price-override-modal.tsx">
"use client";

import { useState, useEffect } from "react";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { AlertTriangle, Lock, ShieldAlert } from "lucide-react";
import { toast } from "sonner";

interface PriceOverrideModalProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  productName: string;
  currentPrice: number;
  unitCost?: number;
  managerPin?: string;
  onConfirm: (newPrice: number, reason?: string) => void;
}

type OverrideStep = "input" | "warning" | "auth";

export function PriceOverrideModal({
  open,
  onOpenChange,
  productName,
  currentPrice,
  unitCost,
  managerPin,
  onConfirm,
}: PriceOverrideModalProps) {
  const [newPrice, setNewPrice] = useState(currentPrice.toString());
  const [reason, setReason] = useState("");
  const [error, setError] = useState("");
  const [step, setStep] = useState<OverrideStep>("input");
  const [pin, setPin] = useState("");

  useEffect(() => {
    if (open) {
      setNewPrice(currentPrice.toString());
      setReason("");
      setError("");
      setStep("input");
      setPin("");
    }
  }, [open, currentPrice]);

  const handleNext = () => {
    const price = parseFloat(newPrice);

    if (isNaN(price) || price < 0) {
      setError("Please enter a valid price");
      return;
    }

    if (price === currentPrice) {
      setError("New price must be different from current price");
      return;
    }

    // Check if price is below cost
    if (unitCost && price < unitCost) {
      setStep("warning");
      return;
    }

    // Normal override
    confirmOverride();
  };

  const handleWarningConfirm = () => {
    if (managerPin) {
      setStep("auth");
    } else {
      // If no PIN configured, allow (or maybe block? defaulting to allow with warning for now if no PIN set)
      // Implementation plan said "default 1234", so managerPin should likely be present.
      // If purely not passed, we probably just proceed.
      confirmOverride();
    }
  };

  const handlePinSubmit = () => {
    if (pin === managerPin) {
      confirmOverride();
    } else {
      setError("Incorrect PIN");
      toast.error("Incorrect Manager PIN");
    }
  };

  const confirmOverride = () => {
    onConfirm(parseFloat(newPrice), reason || undefined);
    handleClose();
  };

  const handleClose = () => {
    onOpenChange(false);
  };

  const priceDifference = parseFloat(newPrice) - currentPrice;
  const percentageChange =
    currentPrice > 0
      ? ((priceDifference / currentPrice) * 100).toFixed(1)
      : "0";

  return (
    <Dialog open={open} onOpenChange={handleClose}>
      <DialogContent className="sm:max-w-[425px]">
        {step === "input" && (
          <>
            <DialogHeader>
              <DialogTitle className="flex items-center gap-2">
                <AlertTriangle className="h-5 w-5 text-yellow-500" />
                Override Price
              </DialogTitle>
              <DialogDescription>
                Manually override the price for <strong>{productName}</strong>.
                This action will be logged.
              </DialogDescription>
            </DialogHeader>

            <div className="space-y-4 py-4">
              <div className="space-y-2">
                <Label htmlFor="current-price">Current Price</Label>
                <Input
                  id="current-price"
                  value={`$${currentPrice.toFixed(2)}`}
                  disabled
                  className="bg-muted"
                />
              </div>

              <div className="space-y-2">
                <Label htmlFor="new-price">
                  New Price <span className="text-destructive">*</span>
                </Label>
                <Input
                  id="new-price"
                  type="number"
                  step="0.01"
                  min="0"
                  value={newPrice}
                  onChange={(e) => {
                    setNewPrice(e.target.value);
                    setError("");
                  }}
                  placeholder="Enter new price"
                  autoFocus
                />
                {error && <p className="text-sm text-destructive">{error}</p>}
              </div>

              {newPrice &&
                !isNaN(parseFloat(newPrice)) &&
                parseFloat(newPrice) !== currentPrice && (
                  <div className="rounded-md bg-muted p-3 space-y-1">
                    <div className="flex justify-between text-sm">
                      <span className="text-muted-foreground">
                        Price Change:
                      </span>
                      <span
                        className={
                          priceDifference > 0
                            ? "text-green-600 font-medium"
                            : "text-red-600 font-medium"
                        }
                      >
                        {priceDifference > 0 ? "+" : ""}$
                        {priceDifference.toFixed(2)} (
                        {priceDifference > 0 ? "+" : ""}
                        {percentageChange}%)
                      </span>
                    </div>
                  </div>
                )}

              <div className="space-y-2">
                <Label htmlFor="reason">Reason (Optional)</Label>
                <Textarea
                  id="reason"
                  value={reason}
                  onChange={(e) => setReason(e.target.value)}
                  placeholder="e.g., promotional discount, damaged item"
                  rows={3}
                />
              </div>
            </div>

            <DialogFooter>
              <Button variant="outline" onClick={handleClose}>
                Cancel
              </Button>
              <Button onClick={handleNext} variant="default">
                Next
              </Button>
            </DialogFooter>
          </>
        )}

        {step === "warning" && (
          <>
            <DialogHeader>
              <DialogTitle className="flex items-center gap-2 text-destructive">
                <ShieldAlert className="h-5 w-5" />
                Price Below Cost
              </DialogTitle>
              <DialogDescription>
                This price is below the unit cost of{" "}
                <strong>${unitCost?.toFixed(2)}</strong>. This will result in a
                loss for this sale.
              </DialogDescription>
            </DialogHeader>

            <div className="py-4 space-y-4">
              <div className="p-4 bg-red-50 text-red-900 rounded-md text-sm border border-red-200">
                <p>
                  <strong>Warning:</strong> You are about to sell this item for
                  less than it costs to acquire. Manager authorization is
                  required to proceed.
                </p>
              </div>
              <div className="space-y-2">
                <Label>Loss per unit</Label>
                <div className="font-mono text-red-600 font-bold">
                  -${(unitCost! - parseFloat(newPrice)).toFixed(2)}
                </div>
              </div>
            </div>

            <DialogFooter>
              <Button variant="outline" onClick={() => setStep("input")}>
                Back
              </Button>
              <Button onClick={handleWarningConfirm} variant="destructive">
                Proceed (Requires Auth)
              </Button>
            </DialogFooter>
          </>
        )}

        {step === "auth" && (
          <>
            <DialogHeader>
              <DialogTitle className="flex items-center gap-2">
                <Lock className="h-5 w-5" />
                Manager Authorization
              </DialogTitle>
              <DialogDescription>
                Enter the manager PIN to authorize this below-cost override.
              </DialogDescription>
            </DialogHeader>

            <div className="py-4 space-y-4">
              <div className="space-y-2">
                <Label htmlFor="pin">Manager PIN</Label>
                <Input
                  id="pin"
                  type="password"
                  value={pin}
                  onChange={(e) => {
                    setPin(e.target.value);
                    setError("");
                  }}
                  className="text-center tracking-widest text-lg"
                  placeholder="••••"
                  autoFocus
                  onKeyDown={(e) => {
                    if (e.key === "Enter") handlePinSubmit();
                  }}
                />
                {error && <p className="text-sm text-destructive">{error}</p>}
              </div>
            </div>

            <DialogFooter>
              <Button variant="outline" onClick={() => setStep("warning")}>
                Back
              </Button>
              <Button onClick={handlePinSubmit} variant="default">
                Authorize
              </Button>
            </DialogFooter>
          </>
        )}
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="components/pos/weight-entry-modal.tsx">
"use client";

import { useState, useEffect } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { posWeightEngine } from "@/lib/utils/pos-weight-engine";
import { getSupabaseClient } from "@/lib/supabase/client";
import { toast } from "sonner";
import { Loader2 } from "lucide-react";

interface WeightEntryModalProps {
  open: boolean;
  onClose: () => void;
  product: {
    id: string;
    product_name: string;
    sku: string;
    base_unit?: string;
    inventory_in_grams?: number;
    price_per_gram?: number;
  } | null;
  businessId: string;
  onAddToCart?: (item: {
    inventory_id: string;
    product_name: string;
    sku: string;
    weight_grams: number;
    unit_price: number;
    bulk_tier_applied?: string;
    line_total: number;
  }) => void;
}

export function WeightEntryModal({
  open,
  onClose,
  product,
  businessId,
  onAddToCart,
}: WeightEntryModalProps) {
  const [weightGrams, setWeightGrams] = useState("");
  const [pricePerGram, setPricePerGram] = useState<number | null>(null);
  const [tierName, setTierName] = useState<string | null>(null);
  const [totalPrice, setTotalPrice] = useState<number>(0);
  const [aliases, setAliases] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [loadingAliases, setLoadingAliases] = useState(false);
  const [processing, setProcessing] = useState(false);
  const supabase = getSupabaseClient();

  useEffect(() => {
    if (weightGrams && product && businessId) {
      const calculatePrice = async () => {
        const weight = parseFloat(weightGrams);
        if (weight > 0) {
          const pricing = await posWeightEngine.getBulkPricing(
            businessId,
            product.id,
            weight,
          );

          setPricePerGram(pricing.price_per_gram);
          setTierName(pricing.tier_name || null);
          setTotalPrice(pricing.total_price);
        }
      };

      calculatePrice();
    }
  }, [weightGrams, product, businessId]);

  useEffect(() => {
    if (open && businessId && supabase) {
      const fetchAliases = async () => {
        setLoadingAliases(true);
        try {
          const { data, error } = await supabase
            .from("product_unit_aliases")
            .select("*")
            .eq("business_id", businessId)
            .eq("is_enabled", true)
            .order("quantity", { ascending: true });

          if (error) throw error;
          setAliases(data || []);
        } catch (error) {
          console.error("Error fetching aliases:", error);
        } finally {
          setLoadingAliases(false);
        }
      };

      fetchAliases();
    }
  }, [open, businessId, supabase]);

  const handleAddToCart = () => {
    if (!product) {
      toast.error("No product selected");
      return;
    }

    if (!weightGrams || parseFloat(weightGrams) <= 0) {
      toast.error("Please enter a valid weight");
      return;
    }

    if (pricePerGram === null) {
      toast.error("Failed to calculate price");
      return;
    }

    if (
      product.inventory_in_grams &&
      parseFloat(weightGrams) > product.inventory_in_grams
    ) {
      toast.error(
        `Insufficient weight. Available: ${product.inventory_in_grams.toFixed(2)}g`,
      );
      return;
    }

    setProcessing(true);

    try {
      onAddToCart?.({
        inventory_id: product.id,
        product_name: product.product_name,
        sku: product.sku,
        weight_grams: parseFloat(weightGrams),
        unit_price: totalPrice,
        bulk_tier_applied: tierName || undefined,
        line_total: totalPrice,
      });

      toast.success(`${product.product_name} added to cart`);
      setWeightGrams("");
      setPricePerGram(null);
      setTierName(null);
      setTotalPrice(0);
      onClose();
    } catch (error) {
      console.error("Error adding to cart:", error);
      toast.error("Failed to add item to cart");
    } finally {
      setProcessing(false);
    }
  };

  const weight = weightGrams ? parseFloat(weightGrams) : null;

  return (
    <Dialog open={open} onOpenChange={onClose}>
      <DialogContent className="sm:max-w-md">
        <DialogHeader>
          <DialogTitle>Add {product?.product_name}</DialogTitle>
          <DialogDescription>
            Enter the weight to calculate price
          </DialogDescription>
        </DialogHeader>

        <div className="space-y-4">
          {/* Product Info */}
          <div className="p-4 bg-muted rounded-lg">
            <div className="space-y-1">
              <p className="text-sm text-muted-foreground">Product</p>
              <p className="font-medium">{product?.product_name}</p>
              <p className="text-xs text-muted-foreground">
                SKU: {product?.sku}
              </p>
            </div>
            {product?.inventory_in_grams && (
              <div className="mt-2 pt-2 border-t">
                <p className="text-xs text-muted-foreground">Available</p>
                <p className="font-medium">
                  {product.inventory_in_grams.toFixed(2)}{" "}
                  {product.base_unit || "g"}
                </p>
              </div>
            )}
          </div>

          {/* Weight Input */}
          <div>
            <Label htmlFor="weight">Weight ({product?.base_unit || "g"})</Label>
            <Input
              id="weight"
              type="number"
              step="0.01"
              min="0.01"
              placeholder="0.00"
              value={weightGrams}
              onChange={(e) => setWeightGrams(e.target.value)}
              disabled={processing}
              autoFocus
            />
            <p className="text-xs text-muted-foreground mt-1">Minimum: 0.01g</p>
          </div>

          {/* Quick Aliases */}
          {aliases.length > 0 && (
            <div className="space-y-2">
              <Label className="text-xs uppercase text-muted-foreground font-semibold">
                Quick Select
              </Label>
              <div className="flex flex-wrap gap-2">
                {aliases.map((alias) => (
                  <Button
                    key={alias.id}
                    variant="outline"
                    size="sm"
                    className="h-8 text-xs bg-accent/5 hover:bg-accent/20 border-accent/20"
                    onClick={() => setWeightGrams(alias.quantity.toString())}
                  >
                    {alias.alias_name} ({alias.quantity}
                    {alias.standard_unit})
                  </Button>
                ))}
              </div>
            </div>
          )}

          {loadingAliases && (
            <div className="flex items-center gap-2 text-xs text-muted-foreground">
              <Loader2 className="w-3 h-3 animate-spin" />
              Loading quick terms...
            </div>
          )}

          {/* Price Breakdown */}
          {weight && weight > 0 && (
            <div className="space-y-2 p-3 bg-blue-50 border border-blue-200 rounded">
              <div className="flex justify-between items-center text-sm">
                <span className="text-blue-900">
                  Price per {product?.base_unit || "g"}
                </span>
                <span className="font-medium text-blue-900">
                  ${pricePerGram?.toFixed(4)}
                </span>
              </div>

              {tierName && (
                <div className="flex justify-between items-center text-sm">
                  <span className="text-blue-900">Bulk Tier</span>
                  <span className="font-medium text-blue-900 px-2 py-1 bg-blue-100 rounded text-xs">
                    {tierName}
                  </span>
                </div>
              )}

              <div className="border-t border-blue-200 pt-2 flex justify-between items-center font-semibold">
                <span className="text-blue-900">Total Price</span>
                <span className="text-lg text-blue-900">
                  ${totalPrice.toFixed(2)}
                </span>
              </div>
            </div>
          )}

          {/* Actions */}
          <div className="flex gap-3 justify-end pt-4">
            <Button variant="outline" onClick={onClose} disabled={processing}>
              Cancel
            </Button>
            <Button
              onClick={handleAddToCart}
              disabled={processing || !weightGrams}
            >
              {processing ? "Adding..." : "Add to Cart"}
            </Button>
          </div>
        </div>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="components/providers/business-setup-provider.tsx">
"use client";

import { useEffect, useState } from "react";
import { useBusiness } from "@/lib/hooks/use-business";
import { useUserRole } from "@/hooks/use-user-role";
import { BusinessSetupWizard } from "@/components/onboarding/business-setup-wizard";
import { getSupabaseClient } from "@/lib/supabase/client";

export function BusinessSetupProvider({
  children,
}: {
  children: React.ReactNode;
}) {
  const {
    needsSetup,
    loading: businessLoading,
    refreshBusiness,
  } = useBusiness();
  const { role, loading: roleLoading } = useUserRole();
  const [userId, setUserId] = useState<string | null>(null);
  const supabase = getSupabaseClient();

  useEffect(() => {
    async function getUser() {
      if (!supabase) return;
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (user) {
        setUserId(user.id);
      }
    }
    getUser();
  }, [supabase]);

  if (businessLoading || roleLoading) {
    return (
      <div className="h-screen w-screen flex items-center justify-center bg-background">
        <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary" />
      </div>
    );
  }

  // Super admins bypass setup requirement
  if (needsSetup && userId && role !== "super_admin") {
    return <BusinessSetupWizard userId={userId} onComplete={refreshBusiness} />;
  }

  return <>{children}</>;
}
</file>

