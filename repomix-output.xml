            </Button>
          )}
        </div>

        {/* Desktop save */}
        <div className="hidden md:flex justify-end">
          <Button type="submit" disabled={saving} size="lg">
            {saving ? (
              <>
                <Loader2 className="mr-2 h-4 w-4 animate-spin" />
