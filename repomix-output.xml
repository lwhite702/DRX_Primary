"use client";

import { useState, useEffect } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { AIIntelligenceDashboard } from "@/components/ai/ai-intelligence-dashboard";
import { PricingRecommendationCard } from "@/components/ai/pricing-recommendation-card";
import { InventoryForecastCard } from "@/components/ai/inventory-forecast-card";
import { useBusiness } from "@/lib/hooks/use-business";
import { useRealtimeInventory } from "@/lib/hooks/use-realtime";
import { getSupabaseClient } from "@/lib/supabase/client";
import { RefreshCw, AlertTriangle, TrendingUp } from "lucide-react";
import { toast } from "sonner";
import type { AIPricingRecommendation, InventoryForecast } from "@/lib/validations/schemas";

interface AIRecommendations {
  pricing: AIPricingRecommendation | null;
  forecast: InventoryForecast | null;
}

export default function AIIntelligencePage() {
  const { business, loading: businessLoading } = useBusiness();
  const inventory = useRealtimeInventory(business?.id || null);
  const [selectedSku, setSelectedSku] = useState<string>("");
  const [recommendations, setRecommendations] = useState<Map<string, AIRecommendations>>(
    new Map()
  );
  const [loading, setLoading] = useState(false);
  const [searchTerm, setSearchTerm] = useState("");
  const supabase = getSupabaseClient();

  const filteredInventory = inventory.filter(
    (item) =>
      item.sku.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.product_name.toLowerCase().includes(searchTerm.toLowerCase())
  );

  const handleAnalyzeProduct = async (inventoryItem: any) => {
    if (!business?.id) {
      toast.error("Business not found");
      return;
    }

    setLoading(true);
    try {
      const response = await fetch("/api/ai/product-intelligence", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          business_id: business.id,
          inventory_id: inventoryItem.id,
          product_name: inventoryItem.product_name,
          sku: inventoryItem.sku,
          cost: Number(inventoryItem.unit_cost || 0),
          current_price: Number(inventoryItem.selling_price || 0),
          current_stock: inventoryItem.quantity_on_hand,
          reorder_level: inventoryItem.reorder_level,
          margin_requirement: 0.3,
          supplier_lead_time_days: 7,
        }),
      });

      if (!response.ok) {
        throw new Error("Analysis failed");
      }

      const result = await response.json();
      toast.success(`Analysis complete for ${inventoryItem.product_name}`);
      setSelectedSku(inventoryItem.sku);

      // Store recommendations
      const newRecs = new Map(recommendations);
      newRecs.set(inventoryItem.id, {
        pricing: result.data.pricing,
        forecast: result.data.forecast,
      });
      setRecommendations(newRecs);
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "Analysis failed");
    } finally {
      setLoading(false);
    }
  };

  const handleAnalyzeAll = async () => {
    if (!business?.id) {
      toast.error("Business not found");
      return;
    }

    setLoading(true);
    try {
      const response = await fetch("/api/ai/analyze", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          business_id: business.id,
          analysis_type: "all",
        }),
      });

      if (!response.ok) {
        throw new Error("Batch analysis failed");
      }

      const result = await response.json();
      toast.success(
        `Batch analysis complete: ${result.summary.processed_count} items processed`
      );
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "Batch analysis failed");
    } finally {
      setLoading(false);
    }
  };

  if (businessLoading) {
    return <div className="p-4 md:p-8">Loading...</div>;
  }

  if (!business) {
    return (
      <div className="p-4 md:p-8">
        <p className="text-muted-foreground">
          No business found. Please set up your business first.
        </p>
      </div>
    );
  }

  return (
    <div className="p-4 md:p-8 space-y-6">
      {/* Header */}
      <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 className="text-3xl font-bold">AI Intelligence Center</h1>
          <p className="text-muted-foreground mt-2">
            Pricing recommendations, inventory forecasting, and demand analytics
          </p>
        </div>
        <Button
          onClick={handleAnalyzeAll}
          disabled={loading}
          size="lg"
          className="w-full md:w-auto"
        >
          <RefreshCw className="h-4 w-4 mr-2" />
          {loading ? "Analyzing..." : "Analyze All Products"}
        </Button>
      </div>

      {/* Dashboard */}
      <AIIntelligenceDashboard businessId={business.id} />

      {/* Search and Selection */}
      <Card>
        <CardHeader>
          <CardTitle>Product Analysis</CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="flex gap-2">
            <div className="flex-1">
              <Input
                placeholder="Search by SKU or product name..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
              />
            </div>
          </div>

          {filteredInventory.length === 0 ? (
            <p className="text-muted-foreground text-center py-8">
              No products found
            </p>
          ) : (
            <>
              {/* Mobile cards */}
              <div className="md:hidden space-y-3">
                {filteredInventory.map((item) => {
                  const cost = Number(item.unit_cost || 0);
                  const price = Number(item.selling_price || 0);
                  const margin = cost > 0 ? (((price - cost) / cost) * 100).toFixed(0) : "0";
                  const lowStock = item.quantity_on_hand <= item.reorder_level;

                  return (
                    <Card key={item.id} className="border-border/80">
                      <CardContent className="pt-4">
                        <div className="flex items-start justify-between gap-3">
                          <div className="min-w-0">
                            <p className="font-medium break-words">{item.product_name}</p>
                            <p className="text-sm text-muted-foreground mt-1">
                              <span className="font-mono">{item.sku}</span>
                            </p>
                          </div>
                          <Button
                            onClick={() => handleAnalyzeProduct(item)}
                            disabled={loading}
                            size="sm"
                            variant="outline"
                          >
                            Analyze
                          </Button>
                        </div>

                        <div className="mt-3 grid grid-cols-2 gap-3 text-sm">
                          <div>
                            <p className="text-xs text-muted-foreground">Stock</p>
                            <p className={lowStock ? "font-bold text-destructive" : "font-medium"}>
                              {item.quantity_on_hand}
                            </p>
                          </div>
                          <div>
                            <p className="text-xs text-muted-foreground">Margin</p>
                            <p className="font-medium">{margin}%</p>
                          </div>
                          <div>
                            <p className="text-xs text-muted-foreground">Cost</p>
                            <p className="font-medium">${cost.toFixed(2)}</p>
                          </div>
                          <div>
                            <p className="text-xs text-muted-foreground">Price</p>
                            <p className="font-medium">${price.toFixed(2)}</p>
                          </div>
                        </div>
                      </CardContent>
                    </Card>
                  );
                })}
              </div>

              {/* Desktop table */}
              <div className="hidden md:block">
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>SKU</TableHead>
                      <TableHead>Product Name</TableHead>
                      <TableHead>Stock</TableHead>
                      <TableHead>Cost</TableHead>
                      <TableHead>Price</TableHead>
                      <TableHead>Margin</TableHead>
                      <TableHead>Action</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {filteredInventory.map((item) => {
                      const cost = Number(item.unit_cost || 0);
                      const price = Number(item.selling_price || 0);
                      const margin = cost > 0 ? ((price - cost) / cost * 100).toFixed(0) : "0";

                      return (
                        <TableRow key={item.id}>
                          <TableCell className="font-mono font-bold">
                            {item.sku}
                          </TableCell>
                          <TableCell>{item.product_name}</TableCell>
                          <TableCell>
                            <span
                              className={
                                item.quantity_on_hand <= item.reorder_level
                                  ? "text-destructive font-bold"
                                  : ""
                              }
                            >
                              {item.quantity_on_hand}
                            </span>
                          </TableCell>
                          <TableCell>${cost.toFixed(2)}</TableCell>
                          <TableCell>${price.toFixed(2)}</TableCell>
                          <TableCell>{margin}%</TableCell>
                          <TableCell>
                            <Button
                              onClick={() => handleAnalyzeProduct(item)}
                              disabled={loading}
                              size="sm"
                              variant="outline"
                            >
                              Analyze
                            </Button>
                          </TableCell>
                        </TableRow>
                      );
                    })}
                  </TableBody>
                </Table>
              </div>
            </>
          )}
        </CardContent>
      </Card>

      {/* Recommendations Display */}
      {recommendations.size > 0 && (
        <div className="space-y-4">
          <h2 className="text-xl font-bold">AI Recommendations</h2>
          {Array.from(recommendations.entries()).map(([inventoryId, recs]) => {
            const item = inventory.find((i) => i.id === inventoryId);
            if (!item) return null;

            return (
              <div key={inventoryId} className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                {recs.pricing && (
                  <PricingRecommendationCard
                    recommendation={recs.pricing}
                    currentPrice={Number(item.selling_price || 0)}
                    productName={item.product_name}
                    sku={item.sku}
                    inventoryId={item.id}
                    businessId={business.id}
                  />
                )}
                {recs.forecast && (
                  <InventoryForecastCard
                    forecast={recs.forecast}
                    currentStock={item.quantity_on_hand}
                    reorderLevel={item.reorder_level}
                    productName={item.product_name}
                    sku={item.sku}
                    inventoryId={item.id}
                    businessId={business.id}
                  />
                )}
              </div>
            );
          })}
        </div>
      )}

      {/* Empty State */}
      {recommendations.size === 0 && filteredInventory.length > 0 && (
        <Card className="border-dashed">
          <CardContent className="pt-12 pb-12 text-center">
            <TrendingUp className="h-12 w-12 text-muted-foreground mx-auto mb-4 opacity-50" />
            <p className="text-muted-foreground">
              Select a product and click "Analyze" to generate AI-powered pricing and inventory
              recommendations
            </p>
          </CardContent>
        </Card>
      )}
    </div>
  );
}
</file>

<file path="app/(app)/credit/page.tsx">
"use client";

import { useState, useEffect } from "react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { TableSkeleton } from "@/components/skeletons/table-skeleton";
import { useBusiness } from "@/lib/hooks/use-business";
import { useRealtimeCredit } from "@/lib/hooks/use-realtime";
import { creditSystem } from "@/lib/utils/credit-system";
import { getSupabaseClient } from "@/lib/supabase/client";
import { CreditExposureDashboard } from "@/components/credit/CreditExposureDashboard";
import {
  Plus,
  DollarSign,
  AlertTriangle,
  FileText,
  Search,
} from "lucide-react";
import { toast } from "sonner";
import { EmptyState } from "@/components/ui/empty-state";
import { useForm } from "react-hook-form";
import { z } from "zod";
import { zodResolver } from "@hookform/resolvers/zod";

const creditExtensionSchema = z.object({
  customer_id: z.string().uuid(),
  amount: z.number().positive(),
  description: z.string().optional(),
  due_date: z.string().date(),
});

const creditPaymentSchema = z.object({
  customer_id: z.string().uuid(),
  amount: z.number().positive(),
  description: z.string().optional(),
});

export default function CreditPage() {
  const { business, loading: businessLoading } = useBusiness();
  const creditTransactions = useRealtimeCredit(business?.id || null);
  const [customers, setCustomers] = useState<any[]>([]);
  const [creditLimits, setCreditLimits] = useState<Map<string, any>>(new Map());
  const [agingData, setAgingData] = useState<any[]>([]);
  const [showExtensionDialog, setShowExtensionDialog] = useState(false);
  const [showPaymentDialog, setShowPaymentDialog] = useState(false);
  const [searchTerm, setSearchTerm] = useState("");
  const supabase = getSupabaseClient();

  const extensionForm = useForm({
    resolver: zodResolver(creditExtensionSchema),
    defaultValues: {
      customer_id: "",
      amount: 0,
      description: "",
      due_date: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
        .toISOString()
        .split("T")[0],
    },
  });

  const paymentForm = useForm({
    resolver: zodResolver(creditPaymentSchema),
    defaultValues: {
      customer_id: "",
      amount: 0,
      description: "",
    },
  });

  useEffect(() => {
    if (!business?.id || !supabase) return;

    fetchCustomers();
    fetchCreditLimits();
    fetchAgingData();
  }, [business?.id, supabase]);

  const fetchCustomers = async () => {
    if (!business?.id || !supabase) return;

    const { data } = await supabase
      .from("customers")
      .select("id, first_name, last_name")
      .eq("business_id", business.id)
      .eq("is_active", true)
      .order("first_name");

    if (data) setCustomers(data);
  };

  const fetchCreditLimits = async () => {
    if (!business?.id || !supabase) return;

    const { data } = await supabase
      .from("credit_limits")
      .select("customer_id, max_credit_limit, current_balance")
      .eq("business_id", business.id);

    if (data) {
      const map = new Map();
      data.forEach((limit) => {
        map.set(limit.customer_id, limit);
      });
      setCreditLimits(map);
    }
  };

  const fetchAgingData = async () => {
    if (!business?.id) return;

    const result = await creditSystem.getCreditAging(business.id);
    if (result.success && result.data) {
      setAgingData(result.data);
    }
  };

  const handleExtension = async (data: any) => {
    if (!business?.id) {
      toast.error("Business not found");
      return;
    }

    const result = await creditSystem.extendCredit(
      business.id,
      data.customer_id,
      data.amount,
      data.description || "",
      data.due_date,
    );

    if (result.success) {
      toast.success("Credit extended successfully");
      setShowExtensionDialog(false);
      extensionForm.reset();
      fetchCreditLimits();
      fetchAgingData();
    } else {
      toast.error(result.error || "Failed to extend credit");
    }
  };

  const handlePayment = async (data: any) => {
    if (!business?.id) {
      toast.error("Business not found");
      return;
    }

    const result = await creditSystem.processPayment(
      business.id,
      data.customer_id,
      data.amount,
      data.description || "",
    );

    if (result.success) {
      toast.success("Payment recorded successfully");
      setShowPaymentDialog(false);
      paymentForm.reset();
      fetchCreditLimits();
      fetchAgingData();
    } else {
      toast.error(result.error || "Failed to record payment");
    }
  };

  const filteredAgingData = agingData.filter((a) =>
    a.customer_name.toLowerCase().includes(searchTerm.toLowerCase()),
  );

  const pendingTransactions = creditTransactions.filter(
    (tx) => tx.status === "pending",
  );
  const delinquentCount = filteredAgingData.filter(
    (a) => a.bucket_31_plus > 0 || a.bucket_15_30 > 0,
  ).length;

  if (businessLoading) {
    return (
      <div className="p-4 md:p-8 space-y-6">
        <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <h1 className="text-3xl font-bold">Credit Management</h1>
            <p className="text-muted-foreground mt-2">
              Track credit transactions and fronts
            </p>
          </div>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          {[...Array(3)].map((_, i) => (
            <Card key={i}>
              <CardContent className="pt-6">
                <div className="h-4 w-32 bg-gray-200 rounded animate-pulse mb-2" />
                <div className="h-8 w-16 bg-gray-200 rounded animate-pulse" />
              </CardContent>
            </Card>
          ))}
        </div>
        <TableSkeleton rowCount={5} columnCount={6} />
      </div>
    );
  }

  if (!business) {
    return (
      <div className="p-4 md:p-8">
        No business found. Please set up your business first.
      </div>
    );
  }

  return (
    <div className="p-4 md:p-8 space-y-6">
      <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 className="text-3xl font-bold">Credit Management</h1>
          <p className="text-muted-foreground mt-2">
            Track credit transactions and fronts
          </p>
        </div>
        <div className="flex flex-col sm:flex-row gap-2 w-full md:w-auto items-center">
          <div className="relative w-full sm:w-64">
            <Search className="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground" />
            <Input
              placeholder="Search customers..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="pl-8"
              aria-label="Search customers"
            />
          </div>
          <Dialog open={showPaymentDialog} onOpenChange={setShowPaymentDialog}>
            <DialogTrigger asChild>
              <Button variant="outline" className="w-full sm:w-auto">
                <DollarSign className="h-4 w-4 mr-2" />
                Record Payment
              </Button>
            </DialogTrigger>
            <DialogContent>
              <DialogHeader>
                <DialogTitle>Record Credit Payment</DialogTitle>
                <DialogDescription>
                  Record a payment against a credit account
                </DialogDescription>
              </DialogHeader>
              <form
                onSubmit={paymentForm.handleSubmit(handlePayment)}
                className="space-y-4"
              >
                <div className="space-y-2">
                  <Label>Customer *</Label>
                  <Select
                    value={paymentForm.watch("customer_id")}
                    onValueChange={(value) =>
                      paymentForm.setValue("customer_id", value)
                    }
                  >
                    <SelectTrigger>
                      <SelectValue placeholder="Select customer" />
                    </SelectTrigger>
                    <SelectContent>
                      {customers.map((customer) => (
                        <SelectItem key={customer.id} value={customer.id}>
                          {customer.first_name} {customer.last_name}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                </div>
                <div className="space-y-2">
                  <Label>Amount *</Label>
                  <Input
                    type="number"
                    step="0.01"
                    {...paymentForm.register("amount", { valueAsNumber: true })}
                  />
                </div>
                <div className="space-y-2">
                  <Label>Description</Label>
                  <Input {...paymentForm.register("description")} />
                </div>
                <div className="flex justify-end gap-2">
                  <Button
                    type="button"
                    variant="outline"
                    onClick={() => setShowPaymentDialog(false)}
                    disabled={paymentForm.formState.isSubmitting}
                  >
                    Cancel
                  </Button>
                  <Button
                    type="submit"
                    disabled={paymentForm.formState.isSubmitting}
                  >
                    {paymentForm.formState.isSubmitting
                      ? "Recording..."
                      : "Record Payment"}
                  </Button>
                </div>
              </form>
            </DialogContent>
          </Dialog>
          <Dialog
            open={showExtensionDialog}
            onOpenChange={setShowExtensionDialog}
          >
            <DialogTrigger asChild>
              <Button className="w-full sm:w-auto">
                <Plus className="h-4 w-4 mr-2" />
                Extend Credit
              </Button>
            </DialogTrigger>
            <DialogContent>
              <DialogHeader>
                <DialogTitle>Extend Credit (Front)</DialogTitle>
                <DialogDescription>
                  Extend credit to a customer
                </DialogDescription>
              </DialogHeader>
              <form
                onSubmit={extensionForm.handleSubmit(handleExtension)}
                className="space-y-4"
              >
                <div className="space-y-2">
                  <Label>Customer *</Label>
                  <Select
                    value={extensionForm.watch("customer_id")}
                    onValueChange={(value) =>
                      extensionForm.setValue("customer_id", value)
                    }
                  >
                    <SelectTrigger>
                      <SelectValue placeholder="Select customer" />
                    </SelectTrigger>
                    <SelectContent>
                      {customers.map((customer: any) => {
                        const limit: any = creditLimits.get(customer.id);
                        return (
                          <SelectItem key={customer.id} value={customer.id}>
                            {customer.first_name} {customer.last_name}
                            {limit &&
                              ` (Balance: $${Number(
                                limit.current_balance,
                              ).toFixed(2)} / $${Number(
                                limit.max_credit_limit,
                              ).toFixed(2)})`}
                          </SelectItem>
                        );
                      })}
                    </SelectContent>
                  </Select>
                </div>
                <div className="space-y-2">
                  <Label>Amount *</Label>
                  <Input
                    type="number"
                    step="0.01"
                    {...extensionForm.register("amount", {
                      valueAsNumber: true,
                    })}
                  />
                </div>
                <div className="space-y-2">
                  <Label>Due Date *</Label>
                  <Input type="date" {...extensionForm.register("due_date")} />
                </div>
                <div className="space-y-2">
                  <Label>Description</Label>
                  <Input {...extensionForm.register("description")} />
                </div>
                <div className="flex justify-end gap-2">
                  <Button
                    type="button"
                    variant="outline"
                    onClick={() => setShowExtensionDialog(false)}
                    disabled={extensionForm.formState.isSubmitting}
                  >
                    Cancel
                  </Button>
                  <Button
                    type="submit"
                    disabled={extensionForm.formState.isSubmitting}
                  >
                    {extensionForm.formState.isSubmitting
                      ? "Processing..."
                      : "Extend Credit"}
                  </Button>
                </div>
              </form>
            </DialogContent>
          </Dialog>
        </div>
      </div>

      {/* AI Credit Exposure Dashboard */}
      <CreditExposureDashboard business_id={business.id} />

      {/* Alerts */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <Card>
          <CardContent className="pt-6">
            <p className="text-sm text-muted-foreground">
              Pending Transactions
            </p>
            <p className="text-2xl font-bold">{pendingTransactions.length}</p>
          </CardContent>
        </Card>
        <Card>
          <CardContent className="pt-6">
            <p className="text-sm text-muted-foreground">Delinquent Accounts</p>
            <p className="text-2xl font-bold text-destructive">
              {delinquentCount}
            </p>
          </CardContent>
        </Card>
        <Card>
          <CardContent className="pt-6">
            <p className="text-sm text-muted-foreground">Total Outstanding</p>
            <p className="text-2xl font-bold">
              $
              {agingData
                .reduce((sum, a) => sum + Number(a.total_outstanding || 0), 0)
                .toFixed(2)}
            </p>
          </CardContent>
        </Card>
      </div>

      {/* Credit Aging */}
      {filteredAgingData.length > 0 && (
        <Card>
          <CardHeader>
            <CardTitle>Credit Aging Report</CardTitle>
          </CardHeader>
          <CardContent>
            {/* Mobile cards */}
            <div className="md:hidden space-y-3">
              {filteredAgingData.map((aging) => {
                const hasDelinquent = Number(aging.bucket_31_plus) > 0;
                return (
                  <Card key={aging.customer_id} className="border-border/80">
                    <CardContent className="pt-4">
                      <div className="flex items-start justify-between gap-3">
                        <p className="font-medium break-words">
                          {aging.customer_name}
                        </p>
                        <p className="font-bold">
                          ${Number(aging.total_outstanding).toFixed(2)}
                        </p>
                      </div>

                      <div className="mt-3 grid grid-cols-2 gap-3 text-sm">
                        <div>
                          <p className="text-xs text-muted-foreground">
                            1–7 Days
                          </p>
                          <p className="font-medium">
                            ${Number(aging.bucket_1_7).toFixed(2)}
                          </p>
                        </div>
                        <div>
                          <p className="text-xs text-muted-foreground">
                            8–14 Days
                          </p>
                          <p className="font-medium">
                            ${Number(aging.bucket_8_14).toFixed(2)}
                          </p>
                        </div>
                        <div>
                          <p className="text-xs text-muted-foreground">
                            15–30 Days
                          </p>
                          <p className="font-medium">
                            ${Number(aging.bucket_15_30).toFixed(2)}
                          </p>
                        </div>
                        <div>
                          <p className="text-xs text-muted-foreground">
                            31+ Days
                          </p>
                          <p
                            className={
                              hasDelinquent
                                ? "font-bold text-destructive"
                                : "font-medium"
                            }
                          >
                            ${Number(aging.bucket_31_plus).toFixed(2)}
                          </p>
                        </div>
                      </div>
                    </CardContent>
                  </Card>
                );
              })}
            </div>

            {/* Desktop table */}
            <div className="hidden md:block">
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Customer</TableHead>
                    <TableHead>1-7 Days</TableHead>
                    <TableHead>8-14 Days</TableHead>
                    <TableHead>15-30 Days</TableHead>
                    <TableHead>31+ Days</TableHead>
                    <TableHead>Total Outstanding</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {filteredAgingData.map((aging) => (
                    <TableRow key={aging.customer_id}>
                      <TableCell className="font-medium">
                        {aging.customer_name}
                      </TableCell>
                      <TableCell>
                        ${Number(aging.bucket_1_7).toFixed(2)}
                      </TableCell>
                      <TableCell>
                        ${Number(aging.bucket_8_14).toFixed(2)}
                      </TableCell>
                      <TableCell>
                        ${Number(aging.bucket_15_30).toFixed(2)}
                      </TableCell>
                      <TableCell
                        className={
                          aging.bucket_31_plus > 0
                            ? "text-destructive font-bold"
                            : ""
                        }
                      >
                        ${Number(aging.bucket_31_plus).toFixed(2)}
                      </TableCell>
                      <TableCell className="font-bold">
                        ${Number(aging.total_outstanding).toFixed(2)}
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </div>
          </CardContent>
        </Card>
      )}

      {/* Recent Transactions */}
      <Card>
        <CardHeader>
          <CardTitle>Recent Credit Transactions</CardTitle>
        </CardHeader>
        <CardContent>
          {creditTransactions.length === 0 ? (
            <EmptyState
              icon={FileText}
              title="No transactions yet"
              description="Extension and payment history will appear here."
              className="border-none bg-transparent"
            />
          ) : (
            <>
              {/* Mobile cards */}
              <div className="md:hidden space-y-3">
                {creditTransactions.slice(0, 20).map((tx) => (
                  <Card key={tx.id} className="border-border/80">
                    <CardContent className="pt-4">
                      <div className="flex items-start justify-between gap-3">
                        <div className="min-w-0">
                          <p className="font-medium capitalize">
                            {tx.transaction_type}
                          </p>
                          <p className="text-sm text-muted-foreground mt-1">
                            {new Date(tx.created_at).toLocaleDateString()}
                            {tx.due_date
                              ? ` • Due ${new Date(
                                  tx.due_date,
                                ).toLocaleDateString()}`
                              : ""}
                          </p>
                        </div>
                        <div className="text-right">
                          <p className="font-bold">
                            ${Number(tx.amount).toFixed(2)}
                          </p>
                          <p
                            className={
                              "text-xs mt-1 capitalize " +
                              (tx.status === "completed"
                                ? "text-green-600"
                                : tx.status === "pending"
