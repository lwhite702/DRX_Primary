# Monorepo environment template
# Primary app variables (apps/app). Copy to `apps/app/.env.local` for local development.

# Core app URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BUILD_TIMESTAMP=
VERCEL_ENV=

# Database (Neon + Prisma)
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Authentication (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=
POSTHOG_FLAG_CACHE_TTL_MS=
POSTHOG_FLAG_OVERRIDES_JSON=

# Monitoring / Error tracking
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_METICULOUS_TOKEN=

# Storage (Cloudflare R2)
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=

# Featurebase
FEATUREBASE_JWT_SECRET=
NEXT_PUBLIC_FEATUREBASE_APP_ID=
NEXT_PUBLIC_FEATUREBASE_ORG=

# Redis / Upstash
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Background jobs / scheduled endpoints
CRON_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Privacy / app controls
DRX_PRIVACY_CLEANUP_SECRET=
BYPASS_AUTH_FOR_TESTING=
NEXT_PUBLIC_BYPASS_AUTH_FOR_TESTING=
BYPASS_AUTH_USER_ID=
BYPASS_AUTH_ORG_ID=
DRX_PII_KEY_CURRENT_B64=
DRX_PII_KEY_PREVIOUS_B64=
DRX_PII_HASH_KEY_B64=

# Stable beta E2E gate. Use only with a dedicated beta DATABASE_URL.
BETA_E2E_ENABLED=
BETA_E2E_KEY=
BETA_E2E_USER_ID=
CLERK_E2E_USER_ID=
BETA_E2E_CLERK_ORG_ID=
BETA_E2E_BUSINESS_NAME=
BETA_E2E_PRODUCT_SKU=
BETA_E2E_CUSTOMER_PHONE=
BETA_E2E_CUSTOMER_EMAIL=
CLERK_TESTING_TOKEN=

# Email
RESEND_API_KEY=
