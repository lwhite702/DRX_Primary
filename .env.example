# Monorepo environment template
# Primary app variables (apps/app). Copy to `apps/app/.env.local` for local development.

# Core app URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BUILD_TIMESTAMP=
VERCEL_ENV=
VERCEL_GIT_COMMIT_SHA=

# Database (Convex)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=dev:handsome-llama-678

# Database (Legacy Neon + Prisma)
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Authentication (Clerk)
CLERK_FRONTEND_API_URL=https://clerk.deelrxcrm.app
# Also configure the server-only Clerk key in the matching Convex deployment
# for authenticated ownership checks and session revocation actions.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Configure this signing secret in the matching Convex deployment.
# The web route forwards the original envelope; Convex verifies it before any write.
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# Private platform entry (server only): 32-64 lowercase hex characters.
# Keep unset outside configured environments; generate and store via secret management.
PLATFORM_CONSOLE_SLUG=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=
POSTHOG_FLAG_CACHE_TTL_MS=
POSTHOG_FLAG_OVERRIDES_JSON=
DEPLOYMENT_ENV=development
NEXT_PUBLIC_DEPLOYMENT_ENV=development
SENTRY_ORG=wrelik-0y
SENTRY_PROJECT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# Monitoring / Error tracking
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_METICULOUS_TOKEN=

# Storage (Cloudflare R2)
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=

# Featurebase
FEATUREBASE_JWT_SECRET=
NEXT_PUBLIC_FEATUREBASE_APP_ID=
NEXT_PUBLIC_FEATUREBASE_ORG=

# Redis / Upstash
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Background jobs / scheduled endpoints
CRON_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Privacy / app controls
DRX_PRIVACY_CLEANUP_SECRET=
# DANGER: Strictly prohibited in production! For local testing and CI only.
DANGEROUS_BYPASS_AUTH_FOR_TESTING_ONLY=false
BYPASS_AUTH_USER_ID=
BYPASS_AUTH_ORG_ID=
DRX_PII_KEY_CURRENT_B64=
DRX_PII_KEY_PREVIOUS_B64=
DRX_PII_HASH_KEY_B64=

# Authenticated browser testing
CLERK_TESTING_TOKEN=
BETA_E2E_ENABLED=
BETA_E2E_REQUIRED=
VISUAL_FIXTURES=false

# Email
RESEND_API_KEY=

# Knock notifications (server only; disabled unless explicitly enabled)
KNOCK_API_KEY=
KNOCK_NOTIFICATIONS_ENABLED=false

# Server deployment URL fallback; set to the same deployment as NEXT_PUBLIC_CONVEX_URL.
CONVEX_URL=

# Optional health and preview automation credentials (server/CI only).
HEALTHCHECK_SECRET=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Test-only switch; must remain false in production.
BYPASS_AUTH_FOR_TESTING=false

# Optional fallback demo business name for synthetic/demo seeds
DRX_DEMO_BUSINESS_NAME=
