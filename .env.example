# Database (Neon + Prisma)
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Storage (Cloudflare R2)
R2_ACCESS_KEY_ID="auto"
R2_SECRET_ACCESS_KEY="auto"
R2_BUCKET_NAME="drx-assets"
R2_AccountId="auto"

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Errors (Sentry)
SENTRY_DSN="https://key@sentry.io/12345"

# Email (Resend)
RESEND_API_KEY="re_..."

# Jobs (Inngest)
INNGEST_EVENT_KEY="test_..."
INNGEST_SIGNING_KEY="sign_..."

# General
NEXT_PUBLIC_APP_URL="http://localhost:3000"
