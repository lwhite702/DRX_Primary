{
  "name": "@wrelik/analytics",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./client": "./dist/client.js",
    "./react-native": "./dist/react-native.js",
    "./flags": {
      "import": "./dist/flags.mjs",
      "require": "./dist/flags.js",
      "types": "./dist/flags.d.ts"
    }
  },
  "dependencies": {
    "posthog-js": "^1.310.1",
    "posthog-node": "^3.6.3",
    "posthog-react-native": "^4.54.0",
    "@wrelik/errors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-native": "^0.73.0",
    "tsup": "^8.0.1",
    "vitest": "^1.2.2",
    "@wrelik/eslint-config": "workspace:*",
    "@wrelik/tsconfig": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/react-native.ts src/flags.ts --format cjs,esm --dts --clean",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  }
}
