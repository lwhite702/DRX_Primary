# Database (Neon + Prisma)
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# Storage (Cloudflare R2)
R2_ACCESS_KEY_ID="auto"
R2_SECRET_ACCESS_KEY="auto"
R2_BUCKET_NAME="drx-assets"
R2_ACCOUNT_ID="auto"

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
POSTHOG_PROJECT_API_KEY="phc_..."
POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_FLAG_CACHE_TTL_MS="30000"
POSTHOG_FLAG_OVERRIDES_JSON="{}"

# Errors (Sentry)
SENTRY_DSN="https://key@sentry.io/12345"
NEXT_PUBLIC_SENTRY_DSN="https://key@sentry.io/12345"

# Email (Resend)
RESEND_API_KEY="re_..."

# Jobs (Inngest)
INNGEST_EVENT_KEY="test_..."
INNGEST_SIGNING_KEY="sign_..."

# General
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_METICULOUS_TOKEN=""
CRON_SECRET=""
